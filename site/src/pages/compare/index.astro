---
import Layout from '../../layouts/Layout.astro';
import { getCategory } from '../../data/categories';
import { getServers, stats, bundlePrice } from '../../data/servers';
import { brand } from '../../config/brand';
import { COMPARISONS } from '../../data/compare';
import { seo } from '../../data/pages';
const meta = seo('/compare/', { title: `Compare: ${brand.name} vs Zapier MCP, Composio, QuickBooks and Xero MCP`, description: `Honest comparisons, then all ${stats().servers} servers side by side: category, tools, hosted status and price.` });
const servers = getServers();
const st = stats();
---
<Layout title={meta.title} description={meta.description} crumbs={[{ name: 'Compare', path: '/compare/' }]}>
  <section class="wrap pb-8 pt-14 sm:pt-20">
    <span class="eyebrow">Compare</span>
    <h1 class="display mt-5 !text-[clamp(2.3rem,6vw,4.4rem)]">Honest comparisons.</h1>
    <p class="lead mt-5 max-w-2xl">What we do, what others do, and when to pick the other one. Then every server side by side.</p>
    <ol class="index-list mt-10">
      {COMPARISONS.map((c) => (
        <li><a href={`/compare/${c.slug}/`} class="index-row"><h2 class="index-title">{brand.name} vs {c.name}</h2><p class="index-text">{c.what}</p><span class="index-go" aria-hidden="true">Read</span></a></li>
      ))}
    </ol>
  </section>
  <section class="wrap pb-4"><h2 class="text-2xl font-semibold sm:text-3xl">All servers, side by side</h2><p class="muted mt-2">Tool counts come from each server's SPEC. Hosted means the server answers at a hosted URL today.</p></section>
  <section class="wrap pb-12">
    <div class="card overflow-x-auto">
      <table class="table min-w-[40rem]">
        <thead><tr><th scope="col">Server</th><th scope="col">Category</th><th scope="col">Tools</th><th scope="col">Hosted</th><th scope="col">Pro</th></tr></thead>
        <tbody>
          {servers.map((s) => { const c = getCategory(s.category); return (
            <tr class="cat" style={`--hue:${c.hue}`}>
              <td><a href={`/servers/${s.id}/`} class="font-medium hover:underline">{s.name}</a><p class="muted line-clamp-1 text-[.85rem]">{s.tagline}</p></td>
              <td class="whitespace-nowrap"><span class="flex items-center gap-2 cat-text text-[.88rem]"><span class="dot"></span>{c.short}</span></td>
              <td class="font-mono">{s.tools.filter((t) => !t.name.startsWith('license_')).length || 'unknown'}</td>
              <td>{s.hosted ? 'Yes' : 'Local'}</td>
              <td class="whitespace-nowrap">{s.bundleOnly ? `Bundle $${bundlePrice()}` : s.paid ? `$${s.priceUsd} once` : 'Free'}</td>
            </tr>); })}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
