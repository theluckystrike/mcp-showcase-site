---
import UpdatesNotice from '../../components/UpdatesNotice.astro';
---
<UpdatesNotice title="Confirm your signup" heading="One more click">
  <p>Press the button to join the McpStamp update list: about one email a month with the free MCP servers and Can Claude answers we added.</p>
  <form method="post" action="/updates/confirm" class="mt-6">
    <input type="hidden" name="t" value="" />
    <button type="submit" class="btn btn-primary">Yes, add me to the list</button>
  </form>
  <p class="text-[.95rem]">If you did not ask for this, close the page. Nothing happens unless you press the button.</p>
</UpdatesNotice>
