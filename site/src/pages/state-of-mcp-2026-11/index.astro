---
// s1107: "State of MCP readiness, November 2026" study page. Every number is copied from
// ~/mcpstamp-work/s1102m/scan/INSIGHTS.md (readiness.json generated 2026-11-02T11:25:22Z, engine 1.2.0 rows only).
// Do not recompute them here. Links into /r/ come from data/readiness-servers.json.
import Layout from '../../layouts/Layout.astro';
import CopyCode from '../../components/CopyCode.astro';
import { getRData, rowsOfGrade, gradePath, R_GRADES } from '../../data/readinessServers';

const D = getRData();
const n = (v: number) => v.toLocaleString('en-US');
const examples = D ? rowsOfGrade('A').slice().sort((a, b) => b.tools - a.tools).slice(0, 6) : [];
const notReadyChatgpt = D ? D.rows.filter((r) => r.stores.chatgpt.blockers.includes('tool_open_world')).sort((a, b) => b.tools - a.tools).slice(0, 4) : [];

const HEAD = [
  { v: '95.0%', l: 'of checked URLs responded over HTTPS', s: '33,003 of 34,728' },
  { v: '28.9%', l: 'ready for all four stores', s: '9,541 servers' },
  { v: '31.4%', l: 'blocked by missing ChatGPT tool hints', s: '10,372 servers' },
  { v: '65.2%', l: 'set readOnlyHint or destructiveHint on every tool', s: '13,805 of 21,163' },
  { v: '41.1%', l: 'use OAuth', s: '13,558 servers' },
  { v: '92.3%', l: 'of OAuth servers offer refresh tokens', s: '12,514 of 13,558' },
  { v: '356', l: 'fail the Gemini metadata discovery order', s: 'of 13,435 OAuth servers' },
  { v: '83.1', l: 'average score out of 100', s: 'grade A for 12,738' },
];
const STORE_ROWS = [
  { s: 'Claude', ready: '12,274', p: '37.2%', u: '8,577' },
  { s: 'ChatGPT', ready: '9,814', p: '29.7%', u: '8,633' },
  { s: 'Gemini', ready: '20,080', p: '60.8%', u: '8,761' },
  { s: 'MCP Registry', ready: '30,353', p: '92.0%', u: '' },
  { s: 'All four', ready: '9,541', p: '28.9%', u: '' },
];
const BLOCKERS = [
  ['tool_open_world', 'Explicit readOnlyHint, destructiveHint and openWorldHint (ChatGPT)', '10,372', 'ChatGPT'],
  ['tool_annotations', 'readOnlyHint or destructiveHint on every tool', '7,358', 'Claude, ChatGPT'],
  ['tool_titles', 'Human-readable title on every tool', '7,006', 'Claude, ChatGPT'],
  ['auth_resource', 'Resource metadata "resource" equals the server URL', '1,872', 'Claude'],
  ['auth_prm', 'Protected resource metadata (RFC 9728)', '1,628', 'Claude, ChatGPT'],
  ['initialize', 'initialize over Streamable HTTP', '1,588', 'Claude, ChatGPT, Gemini, Registry'],
  ['auth_as_metadata', 'Authorization server metadata (RFC 8414 / OIDC)', '1,560', 'Claude, ChatGPT, Gemini'],
  ['auth_method', 'Sign-in method the store supports (OAuth or none)', '1,327', 'ChatGPT, Gemini'],
  ['protocol_version', 'Supported protocol version negotiated', '675', 'Gemini'],
  ['auth_gemini_discovery', 'First metadata URL Gemini tries answers 200 with the required fields', '356', 'Gemini'],
];
const GRADE_ROWS = [['A', '12,738'], ['B', '11,709'], ['C', '5,740'], ['D', '188'], ['F', '2,628']];
const toolExample = `{
  "name": "search_orders",
  "title": "Search orders",
  "description": "Find orders by customer, date range or status. Returns up to 50 orders with totals.",
  "inputSchema": { "type": "object", "properties": { "query": { "type": "string" } } },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  }
}`;
const cite = 'McpStamp. State of MCP readiness, November 2026. Scan of the official MCP Registry on 2 November 2026, McpStamp Check engine 1.2.0. https://www.mcpstamp.com/state-of-mcp-2026-11/';
const title = 'State of MCP readiness, November 2026';
const description = 'We checked 34,728 remote MCP servers from the official registry on 2 November 2026. 28.9% of the 33,003 that responded were ready for Claude, ChatGPT, Gemini and the MCP Registry.';
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description, datePublished: '2026-11-07', dateModified: '2026-11-07',
  author: { '@type': 'Organization', name: 'McpStamp', url: new URL('/', Astro.site).href },
  publisher: { '@type': 'Organization', name: 'McpStamp', url: new URL('/', Astro.site).href },
  about: ['Model Context Protocol', 'MCP servers', 'Claude connectors', 'ChatGPT apps', 'Gemini'],
  mainEntityOfPage: new URL('/state-of-mcp-2026-11/', Astro.site).href,
}];
---
<Layout title={title} description={description} jsonLd={jsonLd} ogType="article" crumbs={[{ name: 'State of MCP readiness, November 2026', path: '/state-of-mcp-2026-11/' }]}>
  <section class="relative isolate">
    <div class="grid-lines"></div>
    <div class="wrap pb-8 pt-10 sm:pt-14">
      <span class="eyebrow">Study · 7 November 2026</span>
      <h1 class="display mt-5 max-w-4xl !text-[clamp(2.2rem,5.4vw,4rem)]">State of MCP readiness, November 2026</h1>
      <p class="lead mt-5 max-w-3xl">Fewer than three in ten remote MCP servers are ready for every store. We checked 34,728 of the 35,158 unique remote URLs in the official MCP Registry on 2 November 2026. Of the 33,003 that responded over HTTPS, 9,541 (28.9%) passed every blocking check for Claude, ChatGPT, Gemini and the MCP Registry.</p>
      <p class="mt-4 max-w-3xl muted">The biggest gap isn't auth or transport. It's tool metadata. The three most common blockers are all missing tool hints or titles, and each takes a few lines of JSON to fix.</p>
    </div>
  </section>

  <section class="wrap pb-12" aria-labelledby="sm-head-h">
    <h2 id="sm-head-h" class="sr-only">Headline numbers</h2>
    <dl class="sm-stats">
      {HEAD.map((h) => <div><dt>{h.l}<span class="sm-s">{h.s}</span></dt><dd class="tnum">{h.v}</dd></div>)}
    </dl>
  </section>

  <section class="wrap pb-12" aria-labelledby="sm-8-h">
    <span class="eyebrow">Findings</span>
    <h2 id="sm-8-h" class="h2 mt-3">The eight numbers</h2>
    <ol class="sm-find mt-6">
      <li>
        <h3>Most registry servers answer</h3>
        <p>33,003 of 34,728 checked URLs responded over HTTPS (95.0%). 30,351 of them (92.0% of responders) passed the MCP initialize check. 21,341 returned an initialize result and 9,010 returned a valid OAuth sign-in challenge. The registry lists 54,786 servers (latest versions), 35,817 of them list a Streamable HTTP remote, and that comes to 35,158 unique checkable URLs.</p>
      </li>
      <li>
        <h3>Gemini is the easiest AI store to pass, ChatGPT the hardest</h3>
        <div class="sm-scroll mt-3">
          <table class="table sm-table">
            <thead><tr><th scope="col">Store</th><th scope="col" class="sm-num">Ready</th><th scope="col" class="sm-num">Share of 33,003</th><th scope="col" class="sm-num">Unverified</th></tr></thead>
            <tbody>{STORE_ROWS.map((r) => <tr><th scope="row">{r.s}</th><td class="sm-num tnum">{r.ready}</td><td class="sm-num tnum">{r.p}</td><td class="sm-num tnum">{r.u || '–'}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="mt-3">Unverified means no blocking check failed, but one couldn't run, mostly because the tools sit behind sign-in and we check without credentials.</p>
      </li>
      <li>
        <h3>The top blocker is one missing hint</h3>
        <p>The check <code>tool_open_world</code> (explicit readOnlyHint, destructiveHint and openWorldHint, which ChatGPT asks for) blocks at least one store on 10,372 servers (31.4%). Next come <code>tool_annotations</code> on 7,358, <code>tool_titles</code> on 7,006, <code>auth_resource</code> on 1,872 and <code>auth_prm</code> on 1,628.</p>
      </li>
      <li>
        <h3>About a third of servers skip tool annotations</h3>
        <p>We could list the tools of 21,163 servers. 13,805 of them (65.2%) pass <code>tool_annotations</code>. Only 10,791 (51.0%) set all three hints ChatGPT wants, and 14,157 (66.9%) give every tool a title.</p>
      </li>
      <li>
        <h3>Half the servers ask for no sign-in</h3>
        <p>OAuth 13,558 (41.1%), open 16,534 (50.1%), and 1,327 (4.0%) use an API key or similar, which store clients can't send.</p>
      </li>
      <li>
        <h3>OAuth servers mostly get the basics right</h3>
        <p>Of 13,558 OAuth servers, 12,514 (92.3%) advertise the refresh_token grant and 13,138 (96.9%) offer client registration (DCR or CIMD).</p>
      </li>
      <li>
        <h3>Two newer checks catch a few hundred servers</h3>
        <p>Gemini's metadata discovery order (<code>auth_gemini_discovery</code>) fails on 356 of 13,435 OAuth servers where it ran. ChatGPT's metadata rules (<code>auth_chatgpt_metadata</code>, issuer equality and token_endpoint_auth_methods_supported) fail on 270 of 13,212.</p>
      </li>
      <li>
        <h3>The average score is 83.1</h3>
        <div class="sm-scroll mt-3">
          <table class="table sm-table sm-narrow">
            <thead><tr><th scope="col">Grade</th><th scope="col" class="sm-num">Servers</th><th scope="col">Reports</th></tr></thead>
            <tbody>{GRADE_ROWS.map(([g, c]) => <tr><th scope="row">{g}</th><td class="sm-num tnum">{c}</td><td>{D && rowsOfGrade(g).length > 0 && <a class="link" href={gradePath(g)}>{n(rowsOfGrade(g).length)} grade {g} reports</a>}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="mt-3">Protocol versions were 2025-11-25 on 13,186 servers, 2025-03-26 on 4,865 and 2025-06-18 on 2,623. Another 11,662 returned no initialize result, mostly because they sit behind OAuth.</p>
      </li>
    </ol>
  </section>

  <section class="wrap pb-12" aria-labelledby="sm-blk-h">
    <span class="eyebrow">Blockers</span>
    <h2 id="sm-blk-h" class="h2 mt-3">Top 10 store blockers</h2>
    <p class="muted mt-3 max-w-2xl">Servers where the check blocks at least one store, out of 33,003 that responded.</p>
    <div class="sm-scroll mt-5">
      <table class="table sm-table">
        <thead><tr><th scope="col">Check</th><th scope="col">What it tests</th><th scope="col" class="sm-num">Servers blocked</th><th scope="col">Stores</th></tr></thead>
        <tbody>{BLOCKERS.map(([id, t, c, s]) => <tr><td><code>{id}</code></td><td>{t}</td><td class="sm-num tnum">{c}</td><td>{s}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="wrap pb-12" aria-labelledby="sm-fix-h">
    <span class="eyebrow">Fixes</span>
    <h2 id="sm-fix-h" class="h2 mt-3">How to fix the top three blockers</h2>
    <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
      <div class="prose-site sm-prose">
        <p>All three live in your tool list, so one edit clears them. Give every tool a <code>title</code> and an <code>annotations</code> object with explicit true or false values.</p>
        <p>Set <code>readOnlyHint: true</code> on tools that only read. Set <code>destructiveHint: true</code> on tools that change or delete data, and false on the rest. Claude needs one of the two on every tool (<code>tool_annotations</code>). ChatGPT needs all three hints written out, including <code>openWorldHint</code>, which says whether the tool reaches outside your own system (<code>tool_open_world</code>).</p>
        <p>The title (<code>tool_titles</code>) is the short human name a store shows next to the tool. Keep it in plain words, not the snake_case name.</p>
        <p>Then run <a href="/check/" class="link">McpStamp Check</a> on your URL. It lists any tool that still misses a hint.</p>
      </div>
      <div>
        <CopyCode code={toolExample} label="One tool in tools/list" />
      </div>
    </div>
  </section>

  <section class="wrap pb-12" aria-labelledby="sm-method-h">
    <div class="grid gap-8 border-t-2 border-fg pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-12">
      <div>
        <span class="eyebrow">Method</span>
        <h2 id="sm-method-h" class="h2 mt-3">Method and limits</h2>
      </div>
      <div class="prose-site sm-prose">
        <p>We read every server in the official MCP Registry (registry.modelcontextprotocol.io, latest version of each) and kept the unique Streamable HTTP remote URLs, 35,158 in all. Each one got a single check with McpStamp Check engine 1.2.0 on 2 November 2026, between 07:38 and 11:25 UTC. We sent no credentials and ran at most one check at a time per domain.</p>
        <p>A server counts as responded when it gave any HTTP response that isn't a firewall or gateway error, so 404, 500 and sign-in challenges count. A store is ready when no blocking check failed and every blocking check could run. Store status is the engine's own result for each store, not recomputed.</p>
        <p>We left out 189 of our own URLs, 175 on hosts that returned HTTP 429 (not retried), 2 whose host resolved to a private or reserved address, 66 the engine refuses before any request (a port other than 443 or 8443, sslip.io and nip.io names, a redirect to http, a malformed URL) and 2 engine errors.</p>
        <p>There are limits. We re-checked the URLs that had responded earlier the same day first, then took the rest in random order, so the response rate is biased upward. One check per URL means a server that was briefly down counts as not responding. Without credentials we can't see tools behind sign-in, which is why so many servers are unverified rather than ready. And a ready call means no blocking check failed. It isn't approval from Anthropic, OpenAI or Google.</p>
      </div>
    </div>
  </section>

  {D && (
    <section class="wrap pb-12" aria-labelledby="sm-r-h">
      <span class="eyebrow">Server reports</span>
      <h2 id="sm-r-h" class="h2 mt-3">Look up a server</h2>
      <p class="muted mt-3 max-w-2xl">{n(D.rows.length)} servers have a public report with their score, store calls and fixes. Browse the <a href="/r/" class="link">server reports</a> or a grade list.</p>
      <div class="mt-6 grid gap-8 lg:grid-cols-2">
        <div>
          <h3 class="sm-h3">Grade A servers with the most tools</h3>
          <ul class="sm-links">{examples.map((r) => <li><a href={`/r/${r.slug}/`}>{r.title}</a> <span class="text-faint tnum">{r.tools} tools</span></li>)}</ul>
        </div>
        <div>
          <h3 class="sm-h3">Missing the ChatGPT tool hints</h3>
          <ul class="sm-links">{notReadyChatgpt.map((r) => <li><a href={`/r/${r.slug}/`}>{r.title}</a> <span class="text-faint tnum">{r.tools} tools, grade {r.grade}</span></li>)}</ul>
        </div>
      </div>
      <p class="mt-6 flex flex-wrap gap-x-4 gap-y-1">{R_GRADES.filter((g) => rowsOfGrade(g).length).map((g) => <a class="link" href={gradePath(g)}>Grade {g}</a>)}</p>
    </section>
  )}

  <section class="wrap pb-12" aria-labelledby="sm-cite-h">
    <span class="eyebrow">Cite</span>
    <h2 id="sm-cite-h" class="h2 mt-3">How to cite this study</h2>
    <p class="muted mt-3 max-w-2xl">You're welcome to quote any number here with a link. The aggregate data is on the <a href="/readiness/" class="link">Readiness Index</a> page.</p>
    <div class="mt-4 max-w-3xl"><CopyCode code={cite} /></div>
  </section>

  <section class="wrap pb-16" aria-labelledby="sm-cta-h">
    <div class="sm-cta">
      <div>
        <h2 id="sm-cta-h" class="text-2xl font-bold sm:text-3xl">Check your own server</h2>
        <p class="muted mt-2 max-w-xl">Paste a remote MCP URL. You get the score, the store blockers and the fix for each one in under a minute.</p>
      </div>
      <form action="/check/" method="get" class="sm-cta-form">
        <label for="sm-cta-url" class="sr-only">Remote MCP server URL</label>
        <input id="sm-cta-url" name="url" type="url" inputmode="url" required placeholder="https://example.com/mcp" class="sm-in" autocomplete="url" spellcheck="false" />
        <button type="submit" class="btn btn-primary">Check</button>
      </form>
    </div>
  </section>
</Layout>

<style is:global>
  .sm-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-left: 2px solid var(--text); border-top: 2px solid var(--text); }
  @media (min-width: 900px) { .sm-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .sm-stats > div { border-right: 2px solid var(--text); border-bottom: 2px solid var(--text); padding: 1rem; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: .4rem; }
  .sm-stats dt { font-size: .85rem; color: var(--muted); line-height: 1.35; }
  .sm-s { display: block; font-family: var(--font-mono); font-size: .72rem; color: var(--faint); margin-top: .2rem; }
  .sm-stats dd { font-family: var(--font-mono); font-size: clamp(1.7rem, 3.2vw, 2.4rem); font-weight: 600; line-height: 1; }
  .sm-find { list-style: none; margin: 0; padding: 0; counter-reset: f; max-width: 52rem; }
  .sm-find > li { counter-increment: f; padding: 1.2rem 0 1.2rem 2.6rem; border-top: 1px solid var(--border); position: relative; }
  .sm-find > li::before { content: counter(f); position: absolute; left: 0; top: 1.15rem; font-family: var(--font-mono); font-weight: 700; color: var(--stamp); }
  .sm-find h3 { font-weight: 700; font-size: 1.15rem; }
  .sm-find p { margin-top: .4rem; }
  .sm-find code, .sm-prose code { font-family: var(--font-mono); font-size: .86em; }
  .sm-scroll { overflow-x: auto; }
  .sm-table { min-width: 32rem; }
  .sm-table.sm-narrow { min-width: 20rem; max-width: 30rem; }
  .sm-num, .sm-table th.sm-num { text-align: right; }
  .sm-h3 { font-weight: 700; padding-bottom: .4rem; border-bottom: 2px solid var(--text); }
  .sm-links { list-style: none; margin: 0; padding: 0; }
  .sm-links li { padding: .45rem 0; border-bottom: 1px solid var(--rule); overflow-wrap: anywhere; }
  .sm-links a { font-weight: 600; text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 3px; }
  .sm-cta { display: grid; gap: 1.25rem; padding: 1.5rem; border: 1px solid var(--manila-2); background: var(--manila); border-radius: 3px; }
  @media (min-width: 900px) { .sm-cta { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: center; padding: 2rem; } }
  .sm-cta-form { display: flex; flex-wrap: wrap; gap: .6rem; }
  .sm-in { flex: 1 1 14rem; min-height: 3rem; padding: .5rem .8rem; border: 1px solid var(--border-strong); border-bottom-width: 2px; border-radius: 3px; background: var(--surface-solid); color: var(--text); font-family: var(--font-mono); }
</style>
