---
// /services/: custom work by the maintainer (d-money). Content: data/content/services.json.
// Prices are "from" figures and are a PROPOSAL for the owner (agents/d-money/FINDINGS.md). show_prices=false hides them.
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import SupportBand from '../components/SupportBand.astro';
import TelegramCta from '../components/TelegramCta.astro';
import { brand } from '../config/brand';
import { CONTENT_DIR, stats } from '../data/servers';

const fallback = { show_prices: false, eyebrow: 'Custom work', h1: 'Get an MCP server built around your own data', lead: '', services: [], steps: [], github: null, faq: [] } as any;
let c: any = fallback;
try { c = { ...fallback, ...JSON.parse(fs.readFileSync(path.join(CONTENT_DIR, 'services.json'), 'utf8')) }; } catch { /* fall back */ }
const st = stats();
const email = 'support@zovo.one';
const tg = brand.links.telegram;
const n = (v: number) => v.toLocaleString('en-US');
const gh = c.github;
const title = 'Custom MCP servers, setup and audits';
const description = `Hire the maintainer of ${st.servers} open-source MCP servers to wrap your API, spreadsheet or docs, set up your team, or audit a server. Fixed quote first.`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Custom MCP work',
    itemListElement: c.services.map((s: any, i: number) => ({ '@type': 'ListItem', position: i + 1,
      item: { '@type': 'Service', name: s.name, description: s.short, serviceType: 'Software development',
        provider: { '@type': 'Person', name: 'theluckystrike', url: brand.links.githubProfile },
        ...(c.show_prices && s.price_from_usd ? { offers: { '@type': 'Offer', priceCurrency: 'USD', priceSpecification: { '@type': 'PriceSpecification', minPrice: s.price_from_usd, priceCurrency: 'USD' } } } : {}) } })) },
  ...(c.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Layout title={title} description={description} crumbs={[{ name: 'Custom work', path: '/services/' }]} jsonLd={jsonLd}>
  <section class="wrap grid gap-10 pb-8 pt-10 sm:pt-14 lg:grid-cols-[1.25fr_1fr] lg:items-start">
    <div>
      <span class="eyebrow">{c.eyebrow}</span>
      <h1 class="display mt-5 max-w-3xl font-display !text-[clamp(2.2rem,4.8vw,3.8rem)]">{c.h1}</h1>
      <p class="lead mt-5">{c.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={tg} rel="noopener" target="_blank" class="btn btn-primary">Describe your job on Telegram</a>
        <p class="text-[.95rem]"><span class="muted">or email </span><span class="select-all font-mono font-semibold">{email}</span></p>
      </div>
    </div>
    <aside class="wo-sheet relative border border-line-strong bg-surface-solid p-5 sm:p-6" aria-label="What a work order covers">
      <div class="flex items-baseline justify-between border-b border-line-strong pb-3">
        <p class="font-display text-lg font-bold uppercase tracking-wide">Work order</p>
        <p class="font-mono text-[.8rem] text-faint">No. ______</p>
      </div>
      <dl class="wo-lines mt-1 text-[.95rem]">
        <div><dt>Job</dt><dd>The task your team repeats every week</dd></div>
        <div><dt>Source</dt><dd>Your API, a spreadsheet or a docs folder</dd></div>
        <div><dt>Tools</dt><dd>Named, typed, listed in SPEC.md</dd></div>
        <div><dt>Tests</dt><dd>One or more for each tool</dd></div>
        <div><dt>Runs in</dt><dd>Claude, Cursor, VS Code, Claude Code</dd></div>
        <div><dt>Owner</dt><dd>You. The code goes in your repo.</dd></div>
      </dl>
      <p class="mt-4 font-mono text-[.78rem] text-faint">Quote: fixed, agreed before work starts</p>
    </aside>
  </section>

  <section class="wrap py-8" aria-labelledby="svc-h">
    <h2 id="svc-h" class="h2 font-display">Three kinds of job</h2>
    <ol class="mt-6 border-t-2 border-fg">
      {c.services.map((s: any, i: number) => (
        <li id={s.id} class="svc-row grid gap-5 border-b border-line-strong py-7 md:grid-cols-[3.5rem_1fr_12rem]">
          <p class="font-mono text-[.9rem] text-faint">{String(i + 1).padStart(2, '0')}</p>
          <div>
            <h3 class="font-display text-[1.45rem] font-bold leading-tight sm:text-[1.7rem]">{s.name}</h3>
            <p class="muted mt-2 max-w-2xl">{s.short}</p>
            <div class="mt-5 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
              <ul class="grid gap-2.5">
                {s.scope.map((x: string) => <li class="scope-li pl-5">{x}</li>)}
              </ul>
              <div>
                <p class="font-mono text-[.75rem] uppercase tracking-wider text-faint">You get</p>
                <ul class="mt-2 grid gap-1.5 text-[.95rem]">
                  {s.you_get.map((x: string) => <li class="muted">{x}</li>)}
                </ul>
              </div>
            </div>
          </div>
          <div class="flex flex-col items-start gap-3 md:items-end md:text-right">
            {c.show_prices && s.price_from_usd ? (
              <p><span class="muted text-[.9rem]">from </span><span class="tnum font-mono text-2xl font-semibold">${n(s.price_from_usd)}</span></p>
            ) : (
              <p class="muted text-[.9rem]">Fixed quote</p>
            )}
            <a href={tg} rel="noopener" target="_blank" class="btn" aria-label={`Ask about: ${s.name}`}>Ask about this</a>
          </div>
        </li>
      ))}
    </ol>
    {c.show_prices && <p class="muted mt-4 text-[.9rem]">Prices are starting points in US dollars. You get a fixed quote for your scope before any work starts.</p>}
  </section>

  {c.steps.length > 0 && (
    <section class="wrap py-10" aria-labelledby="steps-h">
      <h2 id="steps-h" class="h2 font-display">How a job runs</h2>
      <ol class="mt-6 grid gap-0 sm:grid-cols-2 lg:grid-cols-4">
        {c.steps.map((s: any, i: number) => (
          <li class="step relative border border-line bg-surface p-5">
            <p class="font-mono text-[.8rem] text-accent">Step {i + 1}</p>
            <p class="mt-2 font-semibold">{s.title}</p>
            <p class="muted mt-1 text-[.95rem]">{s.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {gh && (
    <section class="wrap py-10" aria-labelledby="gh-h">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr]">
        <div>
          <h2 id="gh-h" class="h2 font-display">Check the work first</h2>
          <p class="muted mt-3 max-w-lg">No client logos here. The code is public, so you can read it before you write. These numbers come straight from the GitHub API.</p>
          <a href={gh.profile_url} rel="noopener" target="_blank" class="btn mt-6">github.com/theluckystrike</a>
        </div>
        <div>
          <dl class="gh-stats grid grid-cols-2 border-l-2 border-t-2 border-fg sm:grid-cols-4">
            <div><dt>Merged pull requests in other people's repos</dt><dd class="tnum">{n(gh.merged_prs_elsewhere)}</dd></div>
            <div><dt>Repos those PRs landed in</dt><dd class="tnum">{n(gh.merged_prs_repos)}</dd></div>
            <div><dt>Public repos</dt><dd class="tnum">{n(gh.public_repos)}</dd></div>
            <div><dt>Stars, all public repos</dt><dd class="tnum">{n(gh.total_stars)}</dd></div>
          </dl>
          <p class="mt-2 font-mono text-[.75rem] text-faint">Measured {gh.as_of} with gh api users/theluckystrike, its repos list and a merged-PR search. <a class="underline underline-offset-2" href={gh.merged_prs_url} rel="noopener" target="_blank">Run the search yourself</a>.</p>
          <p class="mt-6 text-[.92rem] font-semibold">A few merged fixes</p>
          <ul class="mt-2 grid gap-1.5 text-[.95rem]">
            {gh.examples.map((e: any) => (
              <li><a href={e.url} rel="noopener" target="_blank" class="text-accent underline decoration-1 underline-offset-4 hover:no-underline">{e.repo}</a> <span class="muted">{e.title}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  {c.faq.length > 0 && (
    <section class="wrap py-10" aria-labelledby="sfaq-h">
      <h2 id="sfaq-h" class="h2 font-display">Before you write</h2>
      <div class="mt-6 max-w-3xl"><Faq items={c.faq} /></div>
    </section>
  )}

  <section class="wrap py-6">
    <TelegramCta text={`Prefer to talk first? Ask in the community chat, or email ${email}.`} />
  </section>
  <SupportBand page="services" />
</Layout>

<style>
  .wo-sheet { border-radius: 3px; box-shadow: var(--shadow-lift); }
  .wo-lines > div { display: grid; grid-template-columns: 5.5rem 1fr; gap: .75rem; padding: .6rem 0; border-bottom: 1px solid var(--rule); }
  .wo-lines dt { font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--faint); padding-top: .15rem; }
  .scope-li { position: relative; }
  .scope-li::before { content: ''; position: absolute; left: 0; top: .62em; width: .55rem; height: 1px; background: var(--text); }
  .step + .step { margin-top: -1px; }
  @media (min-width: 640px) { .step + .step { margin-top: 0; margin-left: -1px; } .step { border-style: dashed; border-color: var(--border-strong); } }
  .gh-stats > div { border-right: 2px solid var(--text); border-bottom: 2px solid var(--text); padding: .9rem 1rem; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: .25rem; }
  .gh-stats dt { font-size: .78rem; color: var(--muted); line-height: 1.3; }
  .gh-stats dd { font-family: var(--font-mono); font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 600; line-height: 1; }
</style>
