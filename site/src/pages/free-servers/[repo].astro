---
// One page per free live-data server (s1102). Targets "<topic> MCP server". Data: data/content/free-servers.json.
import Layout from '../../layouts/Layout.astro';
import CopyCode from '../../components/CopyCode.astro';
import Faq from '../../components/Faq.astro';
import { brand } from '../../config/brand';
import { getFreeServers, shortDescription, moneyHref, installLines, type FreeServer } from '../../data/freeServers';

export function getStaticPaths() {
  return getFreeServers().map((s) => ({ params: { repo: s.repo }, props: { server: s } }));
}
const { server: s } = Astro.props as { server: FreeServer };
const all = getFreeServers();
const others = all.filter((x) => x.repo !== s.repo);
const lines = installLines(s);
const url = new URL(s.path, Astro.site).href;
const title = `${s.h1}: free, no token`.length <= 60 ? `${s.h1}: free, no token` : s.h1;
const description = `${s.tagline} Free hosted MCP server with ${s.tools.length} tools. Paste one URL into Claude, Cursor or VS Code. No token, no account.`;
const faq = [
  { q: `Is the ${/^.[A-Z]/.test(s.h1) ? s.h1 : s.h1[0].toLowerCase() + s.h1.slice(1)} free?`, a: `Yes. The hosted URL is free and needs no token, key or account. The source is open on GitHub.` },
  { q: 'Why not just ask the model?', a: 'A model answers from its training data. That data stops at a cutoff date, and long sums can drift. This server reads its data or rules each time you ask, so the answer is current and exact.' },
  ...(s.sources ? [{ q: 'Where does the data come from?', a: s.sources }] : []),
  { q: 'Which apps can use it?', a: 'Any MCP client that accepts a remote server URL: Claude.ai and Claude Desktop custom connectors, Claude Code, Cursor, VS Code and others. You can also run it locally with npx.' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', '@id': `${url}#app`, name: s.h1, alternateName: s.repo,
    applicationCategory: 'DeveloperApplication', applicationSubCategory: 'MCP server',
    operatingSystem: 'Claude, Claude Code, Cursor, VS Code (MCP clients)', description: s.tagline, url,
    sameAs: [s.repoUrl, ...(s.npm ? [`https://www.npmjs.com/package/${s.npm}`] : [])],
    featureList: s.tools.map((t) => t.name).join(', '),
    offers: [{ '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free hosted URL' }],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const crumbs = [{ name: 'Free servers', path: '/free-servers/' }, { name: s.h1, path: s.path }];
const money = moneyHref(s, 'page');
const moneyExternal = money && !money.startsWith('/');
---
<Layout title={title} description={description} jsonLd={jsonLd} ogType="product" crumbs={crumbs}>
  <section class="relative isolate">
    <div class="grid-lines"></div>
    <div class="wrap pb-12 pt-8 sm:pt-12">
      <nav class="muted flex flex-wrap items-center gap-2 text-[.88rem]" aria-label="Breadcrumb">
        <a href="/free-servers/" class="hover:text-fg">Free servers</a><span class="text-faint">/</span>
        <span class="text-fg">{s.name}</span>
      </nav>
      <div class="mt-7 grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-14">
        <div>
          <p class="fs-kicker"><span class="fs-tab">Live data</span><span class="fs-tab fs-tab-quiet">No token</span></p>
          <h1 class="display mt-4 !text-[clamp(2.2rem,5vw,3.6rem)]">{s.h1}</h1>
          <p class="lead mt-4 max-w-xl !text-fg">{s.tagline}</p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="#install" class="btn btn-primary">Connect free</a>
            <a href={s.repoUrl} class="btn" rel="noopener">Source on GitHub</a>
          </div>
          <p class="mt-3 text-[.86rem] text-faint">Free. No key, no sign-in, no paid tier. {s.tools.length} tools.</p>
        </div>
        <div>
          <p class="fs-label">Connector URL</p>
          <CopyCode code={s.hostedUrl} />
          <p class="muted mt-3 text-[.92rem]">Paste it as a custom connector in Claude, or add it to Claude Code, Cursor or VS Code. Setup for each is below.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IT KNOWS -->
  <section class="fs-band py-14">
    <div class="wrap grid gap-10 lg:grid-cols-[.8fr_1.4fr]">
      <div>
        <h2 class="h2">What it knows that a model does not</h2>
        <p class="muted mt-3 max-w-sm">A model answers from training data. This server reads the source when you ask.</p>
      </div>
      <div>
        <ul class="fs-knows">{s.knows.map((k) => <li>{k}</li>)}</ul>
        {s.sources && <p class="mt-5 text-[.9rem]"><span class="text-faint">Sources </span>{s.sources}</p>}
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="wrap py-14">
    <h2 class="h2">Tools <span class="muted font-mono text-lg">({s.tools.length})</span></h2>
    <p class="muted mt-3 max-w-2xl">Read from the live server with tools/list{s.toolsChecked && <> on {s.toolsChecked}</>}.</p>
    <div class="mt-6 overflow-x-auto border-t-2 border-fg">
      <table class="table">
        <thead><tr><th scope="col">Tool</th><th scope="col">What it does</th></tr></thead>
        <tbody>{s.tools.map((t) => (
          <tr>
            <td class="whitespace-nowrap"><code class="font-mono text-[.84rem]">{t.name}</code></td>
            <td class="muted">{t.title && <span class="text-fg font-medium">{t.title}. </span>}{shortDescription(t.description)}</td>
          </tr>
        ))}</tbody>
      </table>
    </div>
  </section>

  <!-- INSTALL -->
  <section id="install" class="fs-band py-14">
    <div class="wrap">
      <h2 class="h2">Connect it</h2>
      <p class="muted mt-3 max-w-2xl">One URL, no token. Pick your app.</p>
      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <div>
          <h3 class="fs-h3">Claude.ai and Claude Desktop</h3>
          <p class="muted mt-2 text-[.95rem]">Open Settings, then Connectors, then Add custom connector. Paste the URL. Leave the OAuth fields empty. Save.</p>
          <div class="mt-3"><CopyCode code={lines.claudeAi} /></div>
        </div>
        <div>
          <h3 class="fs-h3">Claude Code</h3>
          <p class="muted mt-2 text-[.95rem]">Run this in your terminal. Then run claude mcp list to check it.</p>
          <div class="mt-3"><CopyCode code={lines.claudeCode} /></div>
        </div>
        <div>
          <h3 class="fs-h3">Cursor</h3>
          <p class="muted mt-2 text-[.95rem]">Merge this into ~/.cursor/mcp.json (all projects) or .cursor/mcp.json (one project).</p>
          <div class="mt-3"><CopyCode code={lines.cursor} /></div>
        </div>
        <div>
          <h3 class="fs-h3">VS Code</h3>
          <p class="muted mt-2 text-[.95rem]">Put this in .vscode/mcp.json. The top key is servers, not mcpServers.</p>
          <div class="mt-3"><CopyCode code={lines.vscode} /></div>
        </div>
      </div>
      {lines.local && <p class="muted mt-8 text-[.95rem]">Prefer to run it on your machine? It is on npm: <code class="font-mono">{lines.local}</code> (needs Node.js).</p>}
    </div>
  </section>

  <!-- PROMPTS -->
  {s.prompts.length > 0 && (
    <section class="wrap py-14">
      <h2 class="h2">Things to ask</h2>
      <p class="muted mt-3 max-w-2xl">Paste one into a new chat after you connect.</p>
      <ul class="mt-6 grid gap-3 md:grid-cols-2">{s.prompts.map((p) => <li class="fs-prompt">{p}</li>)}</ul>
    </section>
  )}

  <!-- LINKS -->
  <section class="wrap py-6">
    <div class="fs-links">
      <a href={s.repoUrl} rel="noopener"><span class="fs-label">Source</span>github.com/theluckystrike/{s.repo}</a>
      {money && <a href={money} rel={moneyExternal ? 'noopener' : undefined}><span class="fs-label">{moneyExternal ? 'Web calculator' : 'Related'}</span>{s.moneySite!.name}</a>}
      {s.npm && <a href={`https://www.npmjs.com/package/${s.npm}`} rel="noopener"><span class="fs-label">npm</span>{s.npm}</a>}
    </div>
  </section>

  <section class="wrap py-14">
    <h2 class="h2">Questions</h2>
    <div class="mt-6 max-w-3xl"><Faq items={faq} /></div>
  </section>

  {others.length > 0 && (
    <section class="wrap py-14">
      <h2 class="h2">More free live-data servers</h2>
      <ul class="fs-others mt-6">
        {others.map((o) => <li><a href={o.path}>{o.h1}</a><span class="muted"> {o.tagline}</span></li>)}
      </ul>
      <p class="mt-6"><a href="/free-servers/" class="link">All free servers</a> <span class="text-faint">·</span> <a href="/servers/" class="link">Back-office servers on {brand.name}</a></p>
    </section>
  )}
</Layout>

<style>
  .fs-kicker { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; }
  .fs-tab { font-family: var(--font-mono); font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: var(--text); background: var(--surface-solid); border: 1px solid var(--border-strong); border-bottom-width: 2px; border-radius: 2px; padding: .22rem .5rem .18rem; }
  .fs-tab-quiet { color: var(--muted); background: transparent; border-color: var(--border); border-bottom-width: 1px; }
  .fs-label { display: block; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); margin-bottom: .6rem; }
  .fs-band { background: var(--bg-2); border-block: 1px solid var(--border); }
  .fs-h3 { font-size: 1.1rem; font-weight: 650; }
  .fs-knows { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--text); }
  .fs-knows li { padding: .8rem 0 .8rem 1.6rem; border-bottom: 1px solid var(--border); position: relative; font-size: 1rem; }
  .fs-knows li::before { content: ''; position: absolute; left: .2rem; top: 1.25rem; width: .6rem; height: 2px; background: var(--stamp); }
  .fs-prompt { padding: .8rem 0 .8rem; border-top: 1px solid var(--border-strong); font-size: .97rem; line-height: 1.5; }
  .fs-links { display: grid; gap: 0; border-top: 2px solid var(--text); border-bottom: 1px solid var(--border-strong); }
  @media (min-width: 768px) { .fs-links { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .fs-links a { padding: 1rem 1rem 1rem 0; overflow-wrap: anywhere; font-weight: 560; }
  .fs-links a:hover { color: var(--accent); }
  .fs-others { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .fs-others li { padding: .7rem 0; border-top: 1px solid var(--border); }
  .fs-others a { font-weight: 620; text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 3px; }
  .fs-others a:hover { text-decoration-color: var(--text); }
</style>
