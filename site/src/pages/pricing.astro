---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { brand } from '../config/brand';
import { getPricing, upsell } from '../data/content';
import { stats, getServers, bundleUrl, bundlePrice, buyUrl } from '../data/servers';
import { seo } from '../data/pages';
import UpsellBand from '../components/UpsellBand.astro';
const meta = seo('/pricing/', { title: 'Pricing', description: '' });
const end = upsell('pricing', 'faq_end', { copy: 'Still unsure? Use the free tier as long as you like.', cta_url: buyUrl(bundleUrl(), 'pricing', 'faq_end') });
// Internal links never carry src tags (seo.json canonical rule). src tags go only on mcp.zovo.one buy links.
const href = (u: string) => (u.startsWith('/') ? u.replace(/\?src=[^#]*/, '') : u);
const paidServers = getServers().filter((s) => s.paid && !s.bundleOnly);
const freeServers = getServers().filter((s) => !s.paid);

const p = getPricing();
const st = stats();
const faq = p.faq.length ? p.faq : [
  { q: 'Is it a subscription?', a: `No. Pro is a one-time payment: $${brand.pricing.serverUsd} for one server or $${brand.pricing.bundleUsd} for all ${st.paid} paid servers. Lifetime licence.` },
  { q: 'Do I need an account for the free tier?', a: 'No. The free tier needs no key and no sign-up. The hosted URL uses a free token you request with one POST.' },
  { q: 'How do I activate Pro?', a: 'Checkout gives you a licence key. Ask your AI to run license_activate with that key. The key is verified offline.' },
];
---
<Layout title={meta.title} description={meta.description || `Free tier with no key. Pro for $${brand.pricing.serverUsd} per server or $${brand.pricing.bundleUsd} for all ${st.paid} paid servers. One-time payment.`}
  crumbs={[{ name: 'Pricing', path: '/pricing/' }]}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: `${brand.name} bundle`, applicationCategory: 'BusinessApplication', operatingSystem: 'Claude, ChatGPT, Cursor, VS Code, Windsurf',
      offers: [
        { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free tier' },
        { '@type': 'Offer', price: String(brand.pricing.serverUsd), priceCurrency: 'USD', name: 'Pro, one server, one-time' },
        { '@type': 'Offer', price: String(bundlePrice()), priceCurrency: 'USD', name: `Bundle, all ${st.paid} paid servers, one-time`, url: buyUrl(bundleUrl(), 'pricing', 'jsonld') },
      ] },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]}>
  <section class="relative isolate overflow-hidden">
    <div class="glow-bg opacity-70"></div>
    <div class="wrap pb-6 pt-14 text-center sm:pt-20">
      <span class="eyebrow">Pricing</span>
      <h1 class="display mx-auto mt-5 max-w-4xl">{meta.h1 || 'Pay once. Keep it.'}</h1>
      <p class="lead mx-auto mt-5 max-w-2xl">Start free. Upgrade the servers that save you time. No subscription.</p>
    </div>
  </section>
  <section class="wrap py-10">
    <div class:list={['mx-auto grid max-w-6xl gap-4', p.plans.length >= 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3']}>
      {p.plans.map((plan) => (
        <div class="card relative flex flex-col p-6" style={plan.highlight ? 'border: 2px solid var(--accent); box-shadow: var(--shadow-lift)' : ''}>
          {plan.highlight && <span class="chip absolute right-4 top-4 !font-semibold" style="background: var(--accent-subtle); color: var(--accent); border-color: transparent">Best value</span>}
          <h2 class="text-lg font-semibold">{plan.name}</h2>
          <p class="tnum mt-3 text-5xl font-semibold tracking-tight">{plan.price}</p>
          <p class="muted mt-1 text-sm">{plan.period}</p>
          <ul class="mt-6 grid gap-2.5 text-[.95rem]">
            {plan.features.map((f) => <li class="flex gap-2.5"><span class="text-accent">+</span><span class="muted">{f}</span></li>)}
          </ul>
          <div class="mt-auto pt-6"><a href={href(plan.cta_url)} rel={plan.cta_url.startsWith('http') ? 'nofollow' : undefined} class:list={['btn w-full', plan.highlight && 'btn-primary']}>{plan.cta_label}</a></div>
        </div>
      ))}
    </div>
  </section>
  {p.proFeatures.length > 0 && (
    <section class="wrap py-10">
      <h2 class="text-2xl font-semibold sm:text-3xl">What Pro adds</h2>
      <ul class="mt-6 grid gap-3 md:grid-cols-2">
        {p.proFeatures.map((f) => <li class="card p-4"><p>{f.text}</p>{f.source && <p class="mt-1 break-words font-mono text-[.72rem] text-faint" title="Source of this limit">{f.source}</p>}</li>)}
      </ul>
    </section>
  )}
  {p.trust.length > 0 && (
    <section class="wrap py-10">
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {p.trust.map((t) => <li class="card p-5 text-[.95rem]">{t.text}</li>)}
      </ul>
    </section>
  )}
  <section class="wrap py-10">
    <h2 class="text-2xl font-semibold sm:text-3xl">Payment questions</h2>
    <div class="mt-6 max-w-3xl"><Faq items={faq} /></div>
    <p class="muted mt-6">{end.copy}</p>
  </section>
  <section class="wrap py-10">
    <h2 class="text-2xl font-semibold sm:text-3xl">Buy one server</h2>
    <p class="muted mt-2">${brand.pricing.serverUsd} once each. Two singles cost ${brand.pricing.serverUsd * 2}; the bundle with all {st.paid} costs ${bundlePrice()}.</p>
    <ul class="mt-6 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
      {paidServers.map((s) => (
        <li class="card flex items-center justify-between gap-3 px-4 py-3">
          <a href={`/servers/${s.id}/`} class="font-medium hover:underline">{s.name}</a>
          <a href={`/servers/${s.id}/#pricing`} class="tnum text-[.92rem] font-semibold text-accent hover:underline" aria-label={`${s.name} Pro, $${s.priceUsd}, Free vs Pro`}>${s.priceUsd}</a>
        </li>
      ))}
    </ul>
    <p class="muted mt-6 text-[.92rem]">Free, no paid tier: {freeServers.map((s, i) => <>{i > 0 && ', '}<a class="link" href={`/servers/${s.id}/`}>{s.name}</a></>)}.</p>
  </section>
</Layout>
