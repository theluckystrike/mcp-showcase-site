---
import Layout from '../../layouts/Layout.astro';
import ServerCard from '../../components/ServerCard.astro';
import CaseTurn from '../../components/CaseTurn.astro';
import StickyCta from '../../components/StickyCta.astro';
import { CATEGORIES, type Category } from '../../data/categories';
import { getServersByCategory, bundleUrl, bundlePrice, buyUrl } from '../../data/servers';
import { upsell } from '../../data/content';
import { seo } from '../../data/pages';
import UpsellBand from '../../components/UpsellBand.astro';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { cat: c.id }, props: { cat: c } }));
}
const { cat } = Astro.props as { cat: Category };
const servers = getServersByCategory(cat.id);
const foot = upsell('category', 'footer', { copy: `Every paid server in this category and the rest, for $${bundlePrice()} once.`, cta_url: buyUrl(bundleUrl(), 'category', 'footer') });
const meta = seo(`/categories/${cat.id}/`, { title: `${cat.name} tools for Claude`, description: `${cat.blurb} ${servers.length} servers for Claude, Cursor and other MCP clients.` });
const cases = servers.flatMap((s) => s.cases.slice(0, 1).map((c) => ({ server: s, case: c }))).slice(0, 3);
---
<Layout title={meta.title} description={meta.description} crumbs={[{ name: 'Servers', path: '/servers/' }, { name: cat.short, path: `/categories/${cat.id}/` }]}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: cat.name, url: new URL(`/categories/${cat.id}/`, Astro.site).href },
    { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: servers.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/servers/${s.id}/`, Astro.site).href, name: s.name })) }]}>
  <div class="cat" style={`--hue:${cat.hue}`}>
    <section class="relative isolate overflow-hidden">
      <div class="grid-lines"></div>
      <div class="wrap pb-10 pt-14 sm:pt-20">
        <span class="eyebrow">Category</span>
        <h1 class="display mt-5 max-w-4xl !text-[clamp(2.3rem,6vw,4.4rem)]">{cat.name}</h1>
        <p class="lead mt-5 max-w-2xl">{cat.blurb} {servers.length} servers.</p>
      </div>
    </section>
    <section class="wrap pb-12">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{servers.map((s) => <ServerCard server={s} />)}</div>
    </section>
    {cases.length > 0 && (
      <section class="wrap py-12">
        <h2 class="text-2xl font-semibold sm:text-3xl">Examples</h2>
        <div class="mt-6 grid gap-4 lg:grid-cols-3">{cases.map((x) => <CaseTurn server={x.server} case={x.case} showServer compact />)}</div>
      </section>
    )}
    <section class="wrap"><UpsellBand copy={foot.copy} href={foot.cta_url} cta={`Bundle, $${bundlePrice()}`} /></section>
    <section class="wrap py-8">
      <h2 class="text-sm font-semibold uppercase tracking-[.08em] text-faint">Other categories</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {CATEGORIES.filter((c) => c.id !== cat.id).map((c) => <a href={`/categories/${c.id}/`} class="chip cat hover:text-fg" style={`--hue:${c.hue}`}><span class="dot"></span>{c.short}</a>)}
      </div>
    </section>
    <StickyCta label={`Pro on every paid server: $${bundlePrice()} once`} sub={foot.copy} href={foot.cta_url} cta="Get bundle" />
  </div>
</Layout>
