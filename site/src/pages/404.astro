---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" noindex>
  <section class="relative isolate overflow-hidden">
    <div class="glow-bg opacity-60"></div>
    <div class="wrap py-28 text-center">
      <p class="font-mono text-sm text-accent-2">404</p>
      <h1 class="display mt-4">Nothing here.</h1>
      <p class="lead mx-auto mt-5 max-w-lg">The page moved or never existed. Try the server directory.</p>
      <div class="mt-8 flex justify-center gap-3"><a href="/servers/" class="btn btn-primary">All servers</a><a href="/" class="btn">Home</a></div>
    </div>
  </section>
</Layout>
