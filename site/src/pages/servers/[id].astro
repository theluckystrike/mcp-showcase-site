---
import Layout from '../../layouts/Layout.astro';
import CaseTurn from '../../components/CaseTurn.astro';
import InstallTabs from '../../components/InstallTabs.astro';
import Faq from '../../components/Faq.astro';
import ServerCard from '../../components/ServerCard.astro';
import ServerOutput from '../../components/ServerOutput.astro';
import { outputType } from './_outputs';
import StickyCta from '../../components/StickyCta.astro';
import { brand } from '../../config/brand';
import { getCategory } from '../../data/categories';
import { getServers, getServersByCategory, bundleUrl, bundlePrice, buyUrl, stats, type Server } from '../../data/servers';
import { upsell } from '../../data/content';
import UpsellBand from '../../components/UpsellBand.astro';
import JobCard from '../../components/JobCard.astro';
import { seo, jobsForServer } from '../../data/pages';

export function getStaticPaths() {
  return getServers().map((s) => ({ params: { id: s.id }, props: { server: s } }));
}
const { server: s } = Astro.props as { server: Server };
const cat = getCategory(s.category);
const related = getServersByCategory(s.category).filter((x) => x.id !== s.id).slice(0, 3);
const buy = (slot: string) => buyUrl(s.buyBase, 'server', slot);
const bundle = (slot: string) => buyUrl(bundleUrl(), 'server', slot);
const vars = { id: s.id, name: s.name };
const paidCount = stats().paid;
// Single-server buy button only when the server has its own Pro tier. office-suite = bundle only. Free servers show the bundle.
const single = s.paid && !s.bundleOnly;
const jobs = jobsForServer(s.id);
const capMsg = upsell('server', 'cap_message', { copy: '', cta_url: buy('cap_message') }, vars);
const worksWith = upsell('server', 'works_with', { copy: '', cta_url: bundle('works_with') }, vars);
const metaBase = `${s.tagline} ${s.hosted ? 'Paste one URL or install locally.' : 'Local install.'} ${single ? `Free tier, $${s.priceUsd} Pro once.` : s.bundleOnly ? `Part of the $${bundlePrice()} bundle.` : 'Free, no paid tier.'}`;
const seoMeta = seo(`/servers/${s.id}/`, { title: `${s.name} for Claude and ChatGPT | ${brand.name}`, description: metaBase });
// QA (t-qa): the sitemap server metas are cut mid-phrase and say "$19 Pro once" for every server, also for the 8 free-only
// servers and the bundle-only office-suite. Use the description built from catalog price data. Keep the sitemap title.
const firstSentence = (s.plain.match(/^[^.!?]+[.!?]/)?.[0] ?? '').trim();
const meta = { ...seoMeta, description: firstSentence && (metaBase + ' ' + firstSentence).length <= 160 ? `${metaBase} ${firstSentence}` : metaBase };
const afterCase = single
  ? upsell('server', 'after_case', { copy: `Doing this every week? Pro removes the free-tier limit for $${s.priceUsd}, once.`, cta_url: buy('after_case') }, vars)
  : { copy: `${s.name} is free. Pro on the other ${paidCount} paid servers: $${bundlePrice()} once.`, cta_url: bundle('after_case') };
const fvpNote = upsell('server', 'free_vs_pro', { copy: '', cta_url: buy('free_vs_pro') }, vars);
const sticky = upsell('server', 'sticky_bar', { copy: `${s.name} Pro: $${s.priceUsd} once. Or all ${paidCount} paid servers for $${bundlePrice()}.`, cta_url: buy('sticky_bar') }, vars);
const stickyBundle = upsell('server', 'sticky_bar_bundle', { copy: `All ${paidCount} for $${bundlePrice()}`, cta_url: bundle('sticky_bar_bundle') }, vars);
const freeList = s.freeVsPro?.free.length ? s.freeVsPro.free : ['Every tool of this server', 'No key, no sign-up'];
const proList = s.freeVsPro?.pro.length ? s.freeVsPro.pro : ['Pro limits of this server: unknown, see the source link'];
const rows = Math.max(freeList.length, s.paid ? proList.length : 0);
const visibleTools = s.tools.filter((t) => !t.name.startsWith('license_'));
const url = new URL(`/servers/${s.id}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', '@id': `${url}#app`, name: s.name, applicationCategory: 'BusinessApplication',
    operatingSystem: 'Claude Desktop, Claude Code, Cursor (MCP clients)', description: s.tagline, url, softwareVersion: s.version || undefined,
    sameAs: s.repo || undefined,
    offers: [
      { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free tier' },
      ...(single ? [{ '@type': 'Offer', price: String(s.priceUsd), priceCurrency: 'USD', name: 'Pro, one-time', url: buy('jsonld') }] : []),
      ...(s.bundleOnly ? [{ '@type': 'Offer', price: String(bundlePrice()), priceCurrency: 'USD', name: 'Bundle, one-time', url: bundle('jsonld') }] : []),
    ],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const crumbs = [{ name: 'Servers', path: '/servers/' }, { name: cat.short, path: `/categories/${cat.id}/` }, { name: s.name, path: `/servers/${s.id}/` }];
---
<Layout title={meta.title} description={meta.description} jsonLd={jsonLd} ogType="product" crumbs={crumbs}>
  <div class="cat" style={`--hue:${cat.hue}`}>
    <!-- HERO: what you get first -->
    <section class="relative isolate">
      <div class="grid-lines"></div>
      <div class="wrap pb-14 pt-8 sm:pt-12">
        <nav class="muted flex flex-wrap items-center gap-2 text-[.88rem]" aria-label="Breadcrumb">
          <a href="/servers/" class="hover:text-fg">Servers</a><span class="text-faint">/</span>
          <a href={`/categories/${cat.id}/`} class="hover:text-fg cat-text">{cat.short}</a><span class="text-faint">/</span>
          <span class="text-fg">{s.name}</span>
        </nav>
        <div class="mt-7 grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:items-start lg:gap-14">
          <div class="lg:pt-4">
            <p class="srv-kicker"><span class="cat-text">{cat.short}</span><span aria-hidden="true">/</span>{outputType(s)}{s.hosted ? <><span aria-hidden="true">/</span>Hosted URL</> : <><span aria-hidden="true">/</span>Local install</>}</p>
            <h1 class="display mt-4 !text-[clamp(2.3rem,5.2vw,3.9rem)]">{s.name}</h1>
            <p class="lead mt-4 max-w-xl !text-fg">{s.tagline}</p>
            {s.plain && <p class="muted mt-4 max-w-xl text-[1rem]">{s.plain}</p>}
            {!s.plain && s.whatItDoes && <p class="muted mt-4 max-w-xl text-[1rem]">{s.whatItDoes}</p>}
            <div class="mt-7 flex flex-wrap items-center gap-3">
              {s.bundleOnly ? (
                <>
                  <a href={bundle('hero')} class="btn btn-primary" rel="nofollow">Get the bundle, ${bundlePrice()} once</a>
                  <a href="#install" class="btn">Install free</a>
                </>
              ) : single ? (
                <>
                  <a href="#install" class="btn btn-primary">Start free</a>
                  <a href={buy('hero')} class="btn" rel="nofollow">Buy Pro, ${s.priceUsd} once</a>
                </>
              ) : (
                <>
                  <a href="#install" class="btn btn-primary">Install free</a>
                  <a href={bundle('hero')} rel="nofollow" class="btn">All {paidCount} paid servers, ${bundlePrice()}</a>
                </>
              )}
            </div>
            <p class="mt-3 text-[.86rem] text-faint">
              {single ? <>Free tier needs no key. <a href="#pricing" class="link">See the exact limits</a>.</> : s.bundleOnly ? <>One key unlocks {paidCount} paid servers. <a href="#pricing" class="link">What's included</a>.</> : <>Free. No paid tier, no key. {s.satellite && s.repo && <a href={s.repo} rel="noopener" class="link">Source on GitHub</a>}</>}
            </p>
            {s.forWho.length > 0 && <p class="mt-6 text-[.9rem]"><span class="text-faint">Made for </span>{s.forWho.join(', ')}</p>}
          </div>
          <div>
            <p class="srv-label">What you get</p>
            <ServerOutput server={s} />
          </div>
        </div>
      </div>
    </section>

    <!-- CASES as one chat transcript -->
    {s.cases.length > 0 ? (
      <section class="srv-band py-14">
        <div class="wrap grid gap-10 lg:grid-cols-[.8fr_1.4fr]">
          <div class="lg:sticky lg:top-24 lg:self-start">
            <h2 class="h2">{s.cases.length} requests, start to finish</h2>
            <p class="muted mt-3 max-w-sm">Example chats. Each one uses real tools of this server, named as they run. The people and firms are made up.</p>
            <p class="muted mt-5 max-w-sm text-[.95rem]">{afterCase.copy} <a href="#pricing" class="link">Free vs Pro</a></p>
          </div>
          <ol class="chat" aria-label="Example chat">
            {s.cases.slice(0, 3).map((c, i) => (
              <li class="chat-case">
                <p class="chat-who">Example {i + 1}{c.persona && <> · {c.persona}</>}<span class="chat-title">{c.title}</span></p>
                <div class="chat-user">{c.prompt}</div>
                {c.steps.length > 0 && (
                  <ul class="chat-tools" aria-label="Tool calls">
                    {c.steps.map((st) => <li><code>{st.tool}</code>{st.via && <span class="text-faint"> via {st.via}</span>}<span class="muted"> {st.does}</span></li>)}
                  </ul>
                )}
                {c.result && (
                  <div class="chat-bot">
                    <p>{c.result}</p>
                    {c.minutes_saved && <p class="mt-1.5 text-[.78rem] text-faint" title={c.minutes_basis}>Saves about {c.minutes_saved} min (our estimate)</p>}
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>
      </section>
    ) : s.tryPrompts.length > 0 && (
      <section class="wrap py-14">
        <h2 class="h2">Things to ask</h2>
        <ul class="mt-6 grid gap-3 md:grid-cols-2">{s.tryPrompts.map((p) => <li class="chat-user !ml-0 !max-w-none">{p}</li>)}</ul>
      </section>
    )}

    <!-- FREE VS PRO ledger -->
    <section id="pricing" class="wrap py-14">
      <h2 class="h2">{s.paid ? 'Free and Pro, line by line' : 'Free, every tool'}</h2>
      {single && fvpNote.copy && <p class="muted mt-3 max-w-2xl">{fvpNote.copy}</p>}
      <div class:list={['ledger mt-8', s.paid && 'ledger-2']}>
        <div class="ledger-head">
          <div><p class="ledger-name">Free</p><p class="ledger-price tnum">$0<span> no key</span></p></div>
          {s.paid && <div class="ledger-pro"><p class="ledger-name">Pro</p><p class="ledger-price tnum">${single ? s.priceUsd : bundlePrice()}<span> once, lifetime{s.bundleOnly && ', bundle'}</span></p></div>}
        </div>
        {Array.from({ length: rows }).map((_, i) => (
          <div class="ledger-row">
            <div>{freeList[i] ?? ''}</div>
            {s.paid && <div class="ledger-pro">{proList[i] ?? ''}</div>}
          </div>
        ))}
        <div class="ledger-row ledger-cta">
          <div><a href="#install" class="btn btn-sm">Install free</a></div>
          {s.paid && <div class="ledger-pro"><a href={single ? fvpNote.cta_url || buy('free_vs_pro') : bundle('free_vs_pro')} rel="nofollow" class="btn btn-primary btn-sm">{single ? `Buy ${s.name} Pro, $${s.priceUsd}` : `Get the bundle, $${bundlePrice()}`}</a></div>}
        </div>
      </div>
      {single && capMsg.copy && <p class="muted mt-5 max-w-3xl text-[.95rem]">{capMsg.copy}</p>}
      {single && <p class="muted mt-3 max-w-3xl text-[.95rem]">Or Pro on all {paidCount} paid servers for ${bundlePrice()} once. <a href={bundle('free_vs_pro_bundle')} rel="nofollow" class="link">Get the bundle</a></p>}
      <p class="mt-4 break-words text-[.78rem] text-faint">Limits read from the code: <span class="font-mono">{s.freeVsPro?.source || 'unknown'}</span></p>
    </section>

    <!-- INSTALL -->
    <section id="install" class="srv-band py-14">
      <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div>
          <h2 class="h2">Install</h2>
          <p class="muted mt-3">Works with Claude, Cursor, VS Code and other MCP clients. {s.hosted ? 'The hosted URL needs no install at all.' : 'This server runs on your machine.'}</p>
          {s.npm && <p class="mt-4 text-[.9rem]"><span class="text-faint">npm </span><code class="font-mono">{s.npm}</code></p>}
        </div>
        <InstallTabs server={s} />
      </div>
    </section>

    {jobs.length > 0 && (
      <section class="wrap py-14">
        <h2 class="h2">Jobs this server does</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{jobs.map((j) => <JobCard page={j} />)}</div>
      </section>
    )}

    <!-- ALL TOOLS -->
    {visibleTools.length > 0 && (
      <section class="wrap py-14">
        <h2 class="h2">All tools <span class="muted font-mono text-lg">({visibleTools.length})</span></h2>
        <div class="mt-6 overflow-x-auto border-t-2 border-fg">
          <table class="table">
            <thead><tr><th scope="col">Tool</th><th scope="col">What it does</th></tr></thead>
            <tbody>{visibleTools.map((t) => <tr><td class="whitespace-nowrap"><code class="font-mono text-[.84rem]">{t.name}</code></td><td class="muted">{t.plain || s.topTools.find((x) => x.name === t.name)?.plain || 'See SPEC.md of this server.'}</td></tr>)}</tbody>
          </table>
        </div>
      </section>
    )}

    {s.faq.length > 0 && (
      <section class="wrap py-14">
        <h2 class="h2">Questions</h2>
        <div class="mt-6 max-w-3xl"><Faq items={s.faq} /></div>
      </section>
    )}

    {related.length > 0 && (
      <section class="wrap py-14">
        <h2 class="h2">More in {cat.short}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{related.map((r) => <ServerCard server={r} />)}</div>
      </section>
    )}

    {single
      ? <StickyCta label={`${s.name} Pro, $${s.priceUsd} once`} sub={sticky.copy} href={sticky.cta_url} cta="Buy Pro" secondary={{ label: stickyBundle.copy, href: stickyBundle.cta_url }} />
      : <StickyCta label={s.bundleOnly ? `${s.name} is in the $${bundlePrice()} bundle` : `${s.name} is free`} sub={`Pro on the ${paidCount} paid servers, $${bundlePrice()} once.`} href={bundle('sticky_bar_bundle')} cta="See bundle" />}
  </div>
</Layout>

<style>
  .srv-kicker { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .82rem; font-weight: 600; color: var(--muted); }
  .srv-kicker span[aria-hidden] { color: var(--border-strong); }
  .srv-label { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); margin-bottom: .7rem; }
  .srv-band { background: var(--bg-2); border-block: 1px solid var(--border); }

  .chat { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.2rem; }
  .chat-case { display: grid; gap: .75rem; }
  .chat-case + .chat-case { padding-top: 2.2rem; border-top: 1px dashed var(--border-strong); }
  .chat-who { font-size: .78rem; color: var(--faint); font-weight: 600; display: flex; flex-wrap: wrap; gap: .25rem .75rem; align-items: baseline; }
  .chat-title { color: var(--text); font-size: 1rem; font-weight: 650; letter-spacing: -0.01em; flex-basis: 100%; }
  .chat-user {
    margin-left: auto; max-width: 88%; padding: .8rem 1rem; border-radius: 1rem 1rem .3rem 1rem;
    background: var(--surface-solid); border: 1px solid var(--border); font-size: .97rem; line-height: 1.5;
  }
  .chat-tools { list-style: none; margin: 0; padding: 0 0 0 .9rem; border-left: 2px solid var(--cat, var(--accent)); display: grid; gap: .35rem; font-size: .86rem; }
  .chat-tools code { font-size: .8rem; font-weight: 600; color: var(--text); }
  .chat-bot {
    max-width: 92%; padding: .85rem 1rem; border-radius: 1rem 1rem 1rem .3rem;
    background: var(--accent-subtle); color: var(--text); font-size: .97rem; line-height: 1.5; font-weight: 520;
  }

  .ledger { border-top: 2px solid var(--text); border-bottom: 2px solid var(--text); }
  .ledger-head, .ledger-row { display: grid; grid-template-columns: 1fr; }
  .ledger-2 .ledger-head, .ledger-2 .ledger-row { grid-template-columns: 1fr 1fr; }
  .ledger-head > div, .ledger-row > div { padding: .8rem 1rem .8rem 0; }
  .ledger-head > div + div, .ledger-row > div + div { padding-left: 1.2rem; border-left: 1px solid var(--border); }
  .ledger-head { border-bottom: 1px solid var(--text); }
  .ledger-row { border-bottom: 1px solid var(--border); font-size: .96rem; }
  .ledger-row:last-child { border-bottom: 0; }
  .ledger-name { font-size: .74rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .ledger-price { font-size: 2rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; margin-top: .2rem; }
  .ledger-price span { font-size: .9rem; font-weight: 450; color: var(--muted); letter-spacing: 0; }
  .ledger-pro { background: color-mix(in oklab, var(--accent) 5%, transparent); }
  .ledger-head .ledger-pro .ledger-name { color: var(--accent); }
  .ledger-cta > div { padding-top: 1rem; padding-bottom: 1rem; }
  @media (max-width: 520px) {
    .ledger-2 .ledger-row, .ledger-2 .ledger-head { font-size: .88rem; }
    .ledger-head > div + div, .ledger-row > div + div { padding-left: .7rem; }
    .ledger-price { font-size: 1.5rem; }
    .ledger-cta .btn { white-space: normal; text-align: center; }
  }
</style>
