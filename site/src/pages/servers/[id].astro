---
import Layout from '../../layouts/Layout.astro';
import CaseTurn from '../../components/CaseTurn.astro';
import InstallTabs from '../../components/InstallTabs.astro';
import Faq from '../../components/Faq.astro';
import ServerCard from '../../components/ServerCard.astro';
import OutputPreview from '../../components/OutputPreview.astro';
import StickyCta from '../../components/StickyCta.astro';
import { brand } from '../../config/brand';
import { getCategory } from '../../data/categories';
import { getServers, getServersByCategory, bundleUrl, bundlePrice, buyUrl, stats, type Server } from '../../data/servers';
import { upsell } from '../../data/content';
import UpsellBand from '../../components/UpsellBand.astro';
import JobCard from '../../components/JobCard.astro';
import { seo, jobsForServer } from '../../data/pages';

export function getStaticPaths() {
  return getServers().map((s) => ({ params: { id: s.id }, props: { server: s } }));
}
const { server: s } = Astro.props as { server: Server };
const cat = getCategory(s.category);
const related = getServersByCategory(s.category).filter((x) => x.id !== s.id).slice(0, 3);
const buy = (slot: string) => buyUrl(s.buyBase, 'server', slot);
const bundle = (slot: string) => buyUrl(bundleUrl(), 'server', slot);
const vars = { id: s.id, name: s.name };
const paidCount = stats().paid;
// Single-server buy button only when the server has its own Pro tier. office-suite = bundle only. Free servers show the bundle.
const single = s.paid && !s.bundleOnly;
const jobs = jobsForServer(s.id);
const capMsg = upsell('server', 'cap_message', { copy: '', cta_url: buy('cap_message') }, vars);
const worksWith = upsell('server', 'works_with', { copy: '', cta_url: bundle('works_with') }, vars);
const metaBase = `${s.tagline} ${s.hosted ? 'Paste one URL or install locally.' : 'Local install.'} ${single ? `Free tier, $${s.priceUsd} Pro once.` : s.bundleOnly ? `Part of the $${bundlePrice()} bundle.` : 'Free, no paid tier.'}`;
const seoMeta = seo(`/servers/${s.id}/`, { title: `${s.name} for Claude and ChatGPT | ${brand.name}`, description: metaBase });
// QA (t-qa): the sitemap server metas are cut mid-phrase and say "$19 Pro once" for every server, also for the 8 free-only
// servers and the bundle-only office-suite. Use the description built from catalog price data. Keep the sitemap title.
const firstSentence = (s.plain.match(/^[^.!?]+[.!?]/)?.[0] ?? '').trim();
const meta = { ...seoMeta, description: firstSentence && (metaBase + ' ' + firstSentence).length <= 160 ? `${metaBase} ${firstSentence}` : metaBase };
const afterCase = single
  ? upsell('server', 'after_case', { copy: `Doing this every week? Pro removes the free-tier limit for $${s.priceUsd}, once.`, cta_url: buy('after_case') }, vars)
  : { copy: `${s.name} is free. Pro on the other ${paidCount} paid servers: $${bundlePrice()} once.`, cta_url: bundle('after_case') };
const fvpNote = upsell('server', 'free_vs_pro', { copy: '', cta_url: buy('free_vs_pro') }, vars);
const sticky = upsell('server', 'sticky_bar', { copy: `${s.name} Pro: $${s.priceUsd} once. Or all ${paidCount} paid servers for $${bundlePrice()}.`, cta_url: buy('sticky_bar') }, vars);
const stickyBundle = upsell('server', 'sticky_bar_bundle', { copy: `All ${paidCount} for $${bundlePrice()}`, cta_url: bundle('sticky_bar_bundle') }, vars);
const hasOutput = s.id === 'invoice' || s.cases.some((c) => /\b(PDF|DOCX|Word|Excel|XLSX|CSV)\b/i.test(c.result ?? ''));
const visibleTools = s.tools.filter((t) => !t.name.startsWith('license_'));
const url = new URL(`/servers/${s.id}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', '@id': `${url}#app`, name: s.name, applicationCategory: 'BusinessApplication',
    operatingSystem: 'Claude, ChatGPT, Cursor, VS Code, Windsurf', description: s.tagline, url, softwareVersion: s.version || undefined,
    sameAs: s.repo || undefined,
    offers: [
      { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free tier' },
      ...(single ? [{ '@type': 'Offer', price: String(s.priceUsd), priceCurrency: 'USD', name: 'Pro, one-time', url: buy('jsonld') }] : []),
      ...(s.bundleOnly ? [{ '@type': 'Offer', price: String(bundlePrice()), priceCurrency: 'USD', name: 'Bundle, one-time', url: bundle('jsonld') }] : []),
    ],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const crumbs = [{ name: 'Servers', path: '/servers/' }, { name: cat.short, path: `/categories/${cat.id}/` }, { name: s.name, path: `/servers/${s.id}/` }];
---
<Layout title={meta.title} description={meta.description} jsonLd={jsonLd} ogType="product" crumbs={crumbs}>
  <div class="cat" style={`--hue:${cat.hue}`}>
    <!-- HERO -->
    <section class="relative isolate overflow-hidden">
      <div class="glow-bg"></div>
      <div class="grid-lines"></div>
      <div class="wrap pb-12 pt-10 sm:pt-16">
        <nav class="muted flex flex-wrap items-center gap-2 text-[.88rem]" aria-label="Breadcrumb">
          <a href="/servers/" class="hover:text-fg">Servers</a><span class="text-faint">/</span>
          <a href={`/categories/${cat.id}/`} class="hover:text-fg cat-text">{cat.short}</a><span class="text-faint">/</span>
          <span class="text-fg">{s.name}</span>
        </nav>
        <div class="mt-8 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-end">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="chip cat-text"><span class="dot"></span>{cat.name}</span>
              {s.hosted ? <span class="chip"><span class="dot" style="--cat: var(--ok)"></span>Hosted URL live</span> : <span class="chip">Local install</span>}
              {s.version && <span class="chip font-mono">v{s.version}</span>}
              {s.satellite && <span class="chip">Free calculator</span>}
            </div>
            <h1 class="display mt-5 !text-[clamp(2.3rem,5.4vw,4rem)]">{s.name}</h1>
            <p class="lead mt-5 max-w-2xl !text-fg">{s.tagline}</p>
            {s.outcomeChips.length > 0 && <div class="mt-6 flex flex-wrap gap-2">{s.outcomeChips.map((c) => <span class="chip">{c}</span>)}</div>}
          </div>
          <div class="card p-5">
            {s.bundleOnly ? (
              <>
                <p class="text-sm font-semibold">One install, {paidCount} paid servers. Sold as the ${bundlePrice()} bundle.</p>
                <div class="mt-4 grid gap-2.5">
                  <a href="#install" class="btn w-full">Install free</a>
                  <a href={bundle('hero')} class="btn btn-primary w-full" rel="nofollow">Get the bundle, ${bundlePrice()} once</a>
                </div>
              </>
            ) : single ? (
              <>
                <p class="text-sm font-semibold">Start free. Pro for ${s.priceUsd} once.</p>
                <div class="mt-4 grid gap-2.5">
                  <a href="#install" class="btn w-full">Install free</a>
                  <a href={buy('hero')} class="btn btn-primary w-full" rel="nofollow">Buy {s.name} Pro, ${s.priceUsd}</a>
                  <a href="/pricing/" class="muted text-center text-[.88rem] hover:text-fg">or Pro on all {paidCount} paid servers for ${bundlePrice()}, see pricing</a>
                </div>
              </>
            ) : (
              <>
                <p class="text-sm font-semibold">Free. Every tool, no paid tier.</p>
                <div class="mt-4 grid gap-2.5">
                  <a href="#install" class="btn btn-primary w-full">Install free</a>
                  <a href={bundle('hero')} rel="nofollow" class="btn w-full">Pro on all {paidCount} paid servers, ${bundlePrice()} once</a>
                  {s.satellite && s.repo && <a href={s.repo} rel="noopener" class="muted text-center text-[.88rem] hover:text-fg">Source on GitHub</a>}
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT IT DOES -->
    <section class="wrap grid gap-10 py-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">What it does</h2>
        <div class="prose-site muted mt-4 text-[1.05rem]">
          <p>{s.plain}</p>
          {s.whatItDoes && s.whatItDoes !== s.plain && <p>{s.whatItDoes}</p>}
        </div>
        {s.forWho.length > 0 && (
          <div class="mt-6"><p class="text-sm font-semibold">Made for</p><div class="mt-2 flex flex-wrap gap-2">{s.forWho.map((w) => <span class="chip">{w}</span>)}</div></div>
        )}
      </div>
      <div class="grid content-start gap-6">
      {hasOutput && (
        <div class="rounded-2xl p-4 sm:p-6" style="background: var(--bg-2)">
          <p class="mb-3 text-[.8rem] font-semibold text-muted">What you get</p>
          <OutputPreview server={s} />
        </div>
      )}
      {s.topTools.length > 0 && (
        <div class="card p-6">
          <h3 class="text-sm font-semibold uppercase tracking-[.08em] text-faint">Key tools</h3>
          <ul class="mt-4 grid gap-3.5">
            {s.topTools.map((t) => (
              <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
                <code class="chip chip-tool shrink-0 self-start">{t.name}</code>
                <span class="muted text-[.95rem]">{t.plain}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      </div>
    </section>

    <!-- CASES -->
    {(s.cases.length > 0 || s.tryPrompts.length > 0) && (
      <section class="wrap py-12">
        <h2 class="text-2xl font-semibold sm:text-3xl">{s.cases.length > 0 ? 'Examples' : 'Things to ask'}</h2>
        <p class="muted mt-2">{s.cases.length > 0 ? 'Example scenarios built on the real tools of this server.' : 'Prompts from the server README.'}</p>
        {s.cases.length > 0 ? (
          <div class="mt-8 grid gap-4 lg:grid-cols-3">{s.cases.slice(0, 3).map((c) => <CaseTurn server={s} case={c} />)}</div>
        ) : (
          <ul class="mt-8 grid gap-3 md:grid-cols-2">
            {s.tryPrompts.map((p) => <li class="card px-5 py-4 text-[.98rem]">"{p}"</li>)}
          </ul>
        )}
        <p class="muted mt-6 text-[.95rem]">{afterCase.copy} <a href="#pricing" class="link">Free vs Pro</a></p>
      </section>
    )}

    {jobs.length > 0 && (
      <section class="wrap py-12">
        <h2 class="text-2xl font-semibold sm:text-3xl">Jobs this server does</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{jobs.map((j) => <JobCard page={j} />)}</div>
      </section>
    )}

    <!-- INSTALL -->
    <section id="install" class="wrap grid gap-10 py-12 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Install</h2>
        <p class="muted mt-3">Works with Claude, Cursor, VS Code and any MCP client. {s.hosted ? 'The hosted URL needs no install at all.' : 'This server runs on your machine.'}</p>
        {s.npm && <p class="mt-4 text-[.9rem]"><span class="text-faint">npm:</span> <code class="font-mono">{s.npm}</code></p>}
      </div>
      <InstallTabs server={s} />
    </section>

    <!-- FREE VS PRO -->
    <section id="pricing" class="wrap py-12">
      <h2 class="text-2xl font-semibold sm:text-3xl">{s.paid ? 'Free vs Pro' : 'Free'}</h2>
      {single && fvpNote.copy && <p class="muted mt-2">{fvpNote.copy}</p>}
      <div class:list={['mt-8 grid gap-4', s.paid && 'md:grid-cols-2']}>
        <div class="card p-6">
          <p class="text-sm font-semibold">Free</p><p class="tnum mt-1 text-3xl font-semibold">$0</p>
          <ul class="muted mt-5 grid gap-2.5 text-[.95rem]">
            {(s.freeVsPro?.free.length ? s.freeVsPro.free : ['Free tier of this server', 'No key, no sign-up']).map((f) => <li class="flex gap-2.5"><span class="text-ok">+</span>{f}</li>)}
          </ul>
        </div>
        {s.paid && (
          <div class="card p-6" style="border: 2px solid var(--accent)">
            <p class="text-sm font-semibold text-accent">Pro</p><p class="tnum mt-1 text-3xl font-semibold">${single ? s.priceUsd : bundlePrice()}<span class="muted text-base font-normal"> once, lifetime{s.bundleOnly && ', bundle'}</span></p>
            <ul class="muted mt-5 grid gap-2.5 text-[.95rem]">
              {(s.freeVsPro?.pro.length ? s.freeVsPro.pro : ['Pro tools of this server (exact list: unknown, see source)', 'Key verified offline']).map((f) => <li class="flex gap-2.5"><span class="text-accent">+</span>{f}</li>)}
            </ul>
            <a href={single ? fvpNote.cta_url : bundle('free_vs_pro')} rel="nofollow" class="btn btn-primary mt-6 w-full">{single ? `Buy ${s.name} Pro` : `Get the bundle, $${bundlePrice()}`}</a>
          </div>
        )}
      </div>
      {single && capMsg.copy && <p class="muted mt-5 max-w-3xl text-[.95rem]">{capMsg.copy}</p>}
      {s.paid && worksWith.copy && ['invoice', 'time-tracker', 'expense-tracker', 'quotes', 'recurring', 'cash-book', 'bank-statement', 'statement-of-account', 'dunning-letters'].includes(s.id) && (
        <p class="muted mt-3 max-w-3xl text-[.95rem]">{worksWith.copy} <a href="/pricing/" class="link">See the bundle</a></p>
      )}
      <details class="mt-4 text-[.78rem] text-faint"><summary class="cursor-pointer">Where these limits come from</summary><p class="mt-1 break-words font-mono">{s.freeVsPro?.source || 'unknown'}</p></details>
    </section>

    <!-- ALL TOOLS -->
    {visibleTools.length > 0 && (
      <section class="wrap py-12">
        <h2 class="text-2xl font-semibold sm:text-3xl">All tools <span class="muted font-mono text-lg">({visibleTools.length})</span></h2>
        <div class="card mt-6 overflow-x-auto">
          <table class="table">
            <thead><tr><th scope="col">Tool</th><th scope="col">What it does</th></tr></thead>
            <tbody>{visibleTools.map((t) => <tr><td class="whitespace-nowrap"><code class="font-mono text-[.84rem]">{t.name}</code></td><td class="muted">{t.plain}</td></tr>)}</tbody>
          </table>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="wrap py-12">
      <h2 class="text-2xl font-semibold sm:text-3xl">FAQ</h2>
      <div class="mt-6 max-w-3xl"><Faq items={s.faq} /></div>
    </section>

    {related.length > 0 && (
      <section class="wrap py-12">
        <h2 class="text-2xl font-semibold sm:text-3xl">More in {cat.short}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{related.map((r) => <ServerCard server={r} />)}</div>
      </section>
    )}

    {single
      ? <StickyCta label={`${s.name} Pro: $${s.priceUsd} once`} sub={sticky.copy} href={sticky.cta_url} cta="Buy Pro" secondary={{ label: stickyBundle.copy, href: stickyBundle.cta_url }} />
      : <StickyCta label={s.bundleOnly ? `${s.name}: part of the $${bundlePrice()} bundle` : `${s.name} is free`} sub={`Pro on the ${paidCount} paid servers: $${bundlePrice()} once.`} href={bundle('sticky_bar_bundle')} cta="See bundle" />}
  </div>
</Layout>
