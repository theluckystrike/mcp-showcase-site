---
// Home (d-home, wave 5). One signature moment: a chat prompt becomes a numbered invoice, and the PAID stamp lands
// when invoice_mark_paid finishes (HeroDemo). Below it: the six jobs buyers search for as a file index, free vs paid
// as a receipt, a short developer strip, the Telegram invite and one closing action.
// Buy CTAs on this page: 2 (hero2, pricing) plus the sticky bar. Every other button is free.
import Layout from '../layouts/Layout.astro';
import HeroDemo from '../components/HeroDemo.astro';
import HomeJobs from '../components/HomeJobs.astro';
import HomePricing from '../components/HomePricing.astro';
import StickyCta from '../components/StickyCta.astro';
import TelegramCta from '../components/TelegramCta.astro';
import { brand } from '../config/brand';
import { stats, bundleUrl, bundlePrice, buyUrl } from '../data/servers';
import { seo } from '../data/pages';
import { CLIENTS } from '../data/content';

const st = stats();
const meta = seo('/', { title: `${brand.name}: ${brand.tagline}`, description: brand.description });
const h1 = meta.h1 ? `${meta.h1}.` : brand.tagline;
const JOB_PATHS = [
  ['Create an invoice', '/use-cases/create-invoice-in-claude/'],
  ['Send a quote', '/use-cases/send-a-quote-from-chat/'],
  ['Work in an Excel file', '/use-cases/edit-excel-files-in-claude/'],
  ['Merge PDFs', '/use-cases/merge-pdf-in-claude/'],
  ['Sort a bank CSV', '/use-cases/categorize-bank-statement/'],
  ['Turn hours into an invoice', '/use-cases/track-billable-time-in-claude/'],
];
const clients = CLIENTS.filter((c) => c.slug !== 'chatgpt').slice(0, 4);
---
<Layout
  title={meta.title}
  description={meta.description}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'ItemList', name: 'Back-office jobs you can do in chat', numberOfItems: JOB_PATHS.length,
    itemListElement: JOB_PATHS.map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(path, Astro.site).href, name })) }]}
>
  <!-- HERO: the signature moment -->
  <section class="hero relative isolate overflow-hidden">
    <div class="grid-lines"></div>
    <div class="wrap grid items-center gap-7 pb-14 pt-7 sm:pt-12 lg:grid-cols-[minmax(0,.74fr)_minmax(0,1.26fr)] lg:items-start lg:gap-10 lg:pb-8 lg:pt-16">
      <div class="hero-copy">
        <h1 class="display">{h1}</h1>
        <p class="mt-3 text-[1.02rem] text-muted sm:hidden">Ask for an invoice, a quote or a PDF. Get the real file back.</p>
        <p class="lead mt-5 hidden sm:block">Type the job in Claude or Cursor. Get the numbered invoice, quote or PDF back as a real file, then mark it paid when the money lands.</p>
        <div class="mt-5 flex flex-wrap gap-3 sm:mt-6">
          <a href="/connect/" class="btn btn-primary">Connect free in 1 minute</a>
          <a href={buyUrl(bundleUrl(), 'home', 'hero2')} rel="nofollow" class="btn hidden sm:inline-flex">All {st.paid} paid servers, ${bundlePrice()} once</a>
        </div>
        <p class="docket mt-7">
          <span>{st.servers} servers</span><span>{st.tools} tools</span><span>{st.hosted} at one URL</span>
        </p>
        <p class="works mt-3 hidden sm:block">Works in {clients.map((c, i) => (<><a href={`/connect/${c.slug}/`}>{c.name}</a>{i < clients.length - 1 ? ', ' : ''}</>))} and <a href="/connect/paste-a-url/">any MCP client</a>.</p>
      </div>
      <HeroDemo />
    </div>
  </section>

  <!-- JOBS: file index -->
  <section id="jobs" class="section pt-6 sm:pt-10">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="eyebrow">Jobs</span>
          <h2 class="h2 mt-3">Six jobs people ask chat to do</h2>
        </div>
        <a href="/use-cases/" class="link text-[.95rem]">All use cases</a>
      </div>
      <p class="lead mt-3">Each one is a real prompt with the tools it calls in order. Names in the examples are made up. The math isn't.</p>
      <div class="mt-8"><HomeJobs /></div>
    </div>
  </section>

  <!-- FREE VS PAID: receipt -->
  <section id="pricing" class="section pt-0">
    <div class="wrap">
      <span class="eyebrow">Free and Pro</span>
      <div class="mt-3"><HomePricing /></div>
    </div>
  </section>

  <!-- DEVELOPERS: one strip -->
  <section id="developers" class="pb-12 sm:pb-16">
    <div class="wrap"><div class="grid items-center gap-6 border-y border-line py-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-12">
      <div>
        <span class="eyebrow">Developers</span>
        <h2 class="mt-3 text-2xl font-bold sm:text-3xl">Open source, stdio or hosted</h2>
        <p class="muted mt-3 max-w-[34em]">Each server lists its tools with real names and inputs. Run it over stdio from npm, or call the hosted endpoint over HTTP with a free token.</p>
        <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-[.95rem]"><a href="/developers/" class="link">Developer docs</a><a href={brand.links.github} class="link" rel="noopener">Source on GitHub</a></p>
      </div>
      <pre class="code">{`# hosted: free token, 30 days, 600 calls an hour
curl -s -X POST ${brand.backend.tokenEndpoint}
claude mcp add --transport http invoice \\
  ${brand.backend.origin}/mcp/invoice/t/<token>

# local over stdio
npx -y @theluckystrike/mcp-invoice`}</pre>
    </div></div>
  </section>

  <!-- COMMUNITY -->
  <section class="pb-4">
    <div class="wrap"><TelegramCta text="Stuck on setup, or want a server that doesn't exist yet? Ask in Zovo Chat. The maintainer reads every message." /></div>
  </section>

  <!-- CLOSING: one action -->
  <section class="section">
    <div class="wrap">
      <div class="closing">
        <h2 class="h2">Your first three invoices this month are free</h2>
        <p class="lead mt-3">Paste one URL into Claude or Cursor. No key, no account. It takes about a minute.</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/connect/" class="btn btn-primary">Connect free in 1 minute</a>
          <a href="/servers/" class="link text-[.95rem]">Or browse all {st.servers} servers</a>
        </div>
      </div>
    </div>
  </section>

  <StickyCta label={`All ${st.paid} paid, $${bundlePrice()} once`} sub="Lifetime licence. The free tier stays free." href={buyUrl(bundleUrl(), 'home', 'sticky')} cta="Get the bundle" secondary={{ label: 'Pricing', href: '/pricing/' }} />
</Layout>

<style>
  .hero-copy .lead { max-width: 30em; }
  @media (min-width: 1024px) { .hero-copy { padding-top: 1.5rem; } .hero-copy .display { font-size: clamp(2.6rem, 4.6vw, 3.9rem); } }
  .docket {
    display: none; flex-wrap: nowrap; gap: 0; margin-bottom: 0; max-width: 34rem; white-space: nowrap;
    font-family: var(--font-mono); font-size: .76rem; letter-spacing: .04em; text-transform: uppercase; color: var(--muted);
    border-top: 2px solid var(--text); border-bottom: 1px solid var(--border-strong); padding: .55rem 0;
  }
  @media (min-width: 640px) { .docket { display: flex; } }
  .docket span { padding-right: .8rem; margin-right: .8rem; border-right: 1px solid var(--border-strong); font-variant-numeric: tabular-nums; }
  .docket span:last-child { border-right: 0; }
  .works { font-size: .9rem; color: var(--muted); }
  .works a { color: var(--text); text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 3px; }
  .works a:hover { text-decoration-color: var(--text); }
  .closing { border-left: 3px solid var(--text); padding: .25rem 0 .25rem 1.25rem; max-width: 46rem; }
  @media (min-width: 768px) { .closing { padding-left: 2rem; } }
</style>
