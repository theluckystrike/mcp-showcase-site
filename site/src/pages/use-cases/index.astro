---
import Layout from '../../layouts/Layout.astro';
import CaseTurn from '../../components/CaseTurn.astro';
import { CATEGORIES, getCategory } from '../../data/categories';
import { allCases, getServers, bundleUrl, bundlePrice, buyUrl } from '../../data/servers';
import { upsell } from '../../data/content';
import UpsellBand from '../../components/UpsellBand.astro';
import JobCard from '../../components/JobCard.astro';
import { pagesOfType, seo } from '../../data/pages';
import { buyerRank } from '../servers/_outputs';
import { getServer } from '../../data/servers';
// Buyer order (same rank as /servers/): invoice, quotes, spreadsheet, pdf first. Stable for ties.
const rankOf = (p: { servers: string[] }) => { const s = p.servers.map((id) => getServer(id)).find((x) => x); return s ? buyerRank(s) : 999; };
const jobs = pagesOfType('use-case').map((p, i) => ({ p, i })).sort((a, b) => rankOf(a.p) - rankOf(b.p) || a.i - b.i).map((x) => x.p);
const answers = pagesOfType('answer');
const meta = seo('/use-cases/', { title: 'Back-office jobs done in chat, with examples', description: 'Example scenarios for invoices, expenses, PDFs, checks and reports, done from Claude, ChatGPT or Cursor.' });
const after = upsell('use-cases', 'after_case', { copy: 'Every example here works on the free tier. Pro removes the limits.', cta_url: buyUrl(bundleUrl(), 'use-cases', 'after_case') });

const cases = allCases();
// One sample slip for the hero: the first invoice case (top buyer job).
const lead = cases.find((x) => x.server.id === 'invoice');
const groups = CATEGORIES.map((c) => ({ cat: c, items: cases.filter((x) => x.server.category === c.id) })).filter((g) => g.items.length);
// Fallback when no content cases exist yet: README prompts per server.
const prompts = cases.length ? [] : getServers().filter((s) => s.tryPrompts.length).map((s) => ({ s, p: s.tryPrompts[0] }));
---
<Layout title={meta.title} description={meta.description} crumbs={[{ name: 'Use cases', path: '/use-cases/' }]}>
  <section class="relative isolate overflow-hidden">
    <div class="grid-lines"></div>
    <div class="wrap grid gap-10 pb-10 pt-14 sm:pt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,25rem)] lg:gap-14">
      <div>
      <span class="eyebrow">Use cases</span>
      <h1 class="display mt-5 max-w-4xl">{meta.h1 || 'What you can do in chat'}</h1>
      <p class="lead mt-5 max-w-2xl">One sentence in. Real tool calls. A finished file out. {jobs.length} jobs below, then {cases.length} example scenarios across {groups.length} categories. Each one uses the real tools of a server.</p>
      {groups.length > 1 && (
        <nav class="cat-jump mt-8" aria-label="Jump to category">
          {groups.map((g) => <a href={`#${g.cat.id}`}>{g.cat.short}</a>)}
        </nav>
      )}
      </div>
      {lead && <aside class="hidden self-start lg:block lg:pt-10" aria-label="Example job"><CaseTurn server={lead.server} case={lead.case} showServer compact /></aside>}
    </div>
  </section>
  <section class="wrap py-10">
    <h2 class="text-2xl font-semibold sm:text-3xl">Pick your job</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{jobs.map((j) => <JobCard page={j} />)}</div>
  </section>
  {answers.length > 0 && (
    <section id="answers" class="wrap py-10">
      <h2 class="text-2xl font-semibold sm:text-3xl">Short answers</h2>
      <ol class="index-list mt-6">{answers.map((a) => <li><a href={a.path} class="index-row"><span class="index-title">{a.h1}</span><span></span><span class="index-go" aria-hidden="true">Read</span></a></li>)}</ol>
    </section>
  )}
  <section class="wrap pt-10"><h2 class="text-2xl font-semibold sm:text-3xl">All examples by category</h2></section>
  {groups.map((g) => (
    <section id={g.cat.id} class="wrap py-10">
      <h2 class="text-2xl font-semibold sm:text-3xl"><a href={`/categories/${g.cat.id}/`} class="hover:underline">{g.cat.name}</a></h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{g.items.map((x) => <CaseTurn server={x.server} case={x.case} showServer />)}</div>
    </section>
  ))}
  <section class="wrap pb-10"><UpsellBand copy={after.copy} href={after.cta_url} cta={`Bundle, $${bundlePrice()}`} /></section>
  {prompts.length > 0 && (
    <section class="wrap py-10">
      <ol class="index-list">
        {prompts.map(({ s, p }) => (
          <li><a href={`/servers/${s.id}/`} class="index-row cat" style={`--hue:${getCategory(s.category).hue}`}>
            <span class="index-title">{s.name}</span>
            <p class="index-text">&ldquo;{p}&rdquo;</p>
            <span class="index-go" aria-hidden="true">Open server</span>
          </a></li>
        ))}
      </ol>
    </section>
  )}
</Layout>

<style>
  /* Category jump row: a drawer-label strip in mono, one ink, ruled. Not 10 colored chips. */
  .cat-jump { display: flex; flex-wrap: wrap; max-width: 52rem; border-top: 2px solid var(--text); border-bottom: 1px solid var(--border-strong); }
  .cat-jump a {
    font-family: var(--font-mono); font-size: .72rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: var(--muted);
    padding: .6rem .85rem .55rem 0; margin-right: .85rem; border-right: 1px solid var(--border); text-decoration: none; line-height: 1.2;
  }
  .cat-jump a:last-child { border-right: 0; }
  .cat-jump a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
</style>
