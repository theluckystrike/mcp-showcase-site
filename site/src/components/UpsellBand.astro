---
// Inline upsell: one sentence + one button. Copy comes from pricing.json upsell_slots via upsell().
interface Props { copy: string; href: string; cta?: string }
const { copy, href, cta = 'Get Pro' } = Astro.props;
---
<div class="card mt-6 flex flex-col items-start gap-4 p-5 sm:flex-row sm:items-center">
  <p class="flex-1 text-[.98rem]">{copy}</p>
  <a href={href} class="btn btn-primary btn-sm shrink-0">{cta}</a>
</div>
