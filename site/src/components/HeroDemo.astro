---
// Static "chat -> tool calls -> result" demo. The first paint shows the WHOLE turn: prompt, tool calls, the finished file.
// Motion (global.css .demo) only pops the check marks and lands the stamp. Nothing starts hidden. Zero JS.
// Uses the first content case of the featured server when it exists; else a fallback built on real invoice tool names.
import { getServer } from '../data/servers';
import { getCategory } from '../data/categories';
import InvoicePreview from './InvoicePreview.astro';
interface Props { serverId?: string }
const { serverId = 'invoice' } = Astro.props;
const s = getServer(serverId);
const cat = getCategory(s?.category ?? 'invoicing');
const c = s?.cases[0];
const prompt = c?.prompt ?? 'Invoice Acme for 12 hours of API work at 90 EUR plus a 300 EUR setup fee, 23% VAT, due in 14 days, and give me the PDF.';
const steps = (c?.steps.length ? c.steps : [
  { tool: 'invoice_create', does: 'Creates INV-2026-0001 with two lines' },
  { tool: 'invoice_pdf', does: 'Renders the A4 PDF' },
]).slice(0, 3);
const result = c?.result ?? 'EUR 1,380.00 subtotal, EUR 317.40 VAT, EUR 1,697.40 total, as a PDF ready to email.';
const showInvoice = serverId === 'invoice';
---
<div class="demo cat relative" style={`--hue:${cat.hue}`}>
  <div class="card overflow-hidden">
    <div class="flex items-center gap-2 border-b border-line px-4 py-2.5" style="background: var(--surface)">
      <span class="h-2.5 w-2.5 rounded-full bg-[#e5dfd4]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#e5dfd4]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#e5dfd4]"></span>
      <span class="ml-2 text-[.78rem] text-faint">Claude, with {s?.name ?? 'Invoice'} connected</span>
      <span class="ml-auto chip !py-0 !text-[.7rem]">Example</span>
    </div>
    <div class="flex flex-col gap-3 p-4 sm:p-5">
      <p class="sr-only">Example chat turn. You type:</p>
      <div data-step class="ml-auto max-w-[90%] rounded-2xl rounded-br-md px-4 py-3 text-[.92rem] leading-relaxed" style="background: var(--surface-2); border: 1px solid var(--border)">{prompt}</div>
      <p class="sr-only">The assistant calls these tools:</p>
      <ol class="flex flex-col gap-1.5">
        {steps.map((st, i) => (
          <li data-step style={`--d:${0.25 + i * 0.35}`} class="shimmer flex items-center gap-2.5 rounded-lg border border-line px-3 py-2 text-[.82rem]" >
            <span class="tick grid h-5 w-5 shrink-0 place-items-center rounded-full" style={`--d:${0.25 + i * 0.35}; background: var(--accent); color: var(--accent-text)`}>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
            </span>
            <code class="font-mono text-[.79rem]">{st.tool}</code>
            <span class="muted hidden truncate sm:inline">{st.does}</span>
          </li>
        ))}
      </ol>
      <p class="sr-only">Result:</p>
      {showInvoice ? (
        <div data-step class="mt-1 rounded-xl p-3 sm:p-4" style="background: var(--bg-2)">
          <InvoicePreview compact caption={false} />
          <p class="mt-3 flex items-center gap-2 text-[.82rem] text-muted"><span class="dot" style="--cat: var(--accent)"></span>{result}</p>
        </div>
      ) : (
        <div data-step class="mt-1 rounded-xl border border-line p-4" style="background: var(--surface)">
          <p class="text-[.72rem] font-semibold cat-text">Result</p>
          <p class="mt-1 text-[.92rem] leading-snug">{result}</p>
        </div>
      )}
    </div>
  </div>
</div>
