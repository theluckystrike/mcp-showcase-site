---
// Home signature moment (d-home, wave 5): a chat prompt turns into a numbered invoice, and a PAID stamp lands when
// invoice_mark_paid finishes. The first frame is the finished state: every line, tick and the stamp are visible at rest.
// Motion is CSS only, plays once, and is off under prefers-reduced-motion. Zero JS. Tokens only, no literal colors.
// Numbers: data/content/a.json, invoice case 1 "Bill a client in one message" (12 h x 90 + 300 setup, 23% VAT, 14 days).
// Turn 2 uses invoice_mark_paid (invoice case 3, servers/invoice/src/index.ts:769, sets status "paid"). Labeled Example.
import { getServer } from '../data/servers';
import Stamp from './Stamp.astro';

const s = getServer('invoice');
const c = s?.cases[0];
const prompt = c?.prompt ?? 'Invoice Acme for 12 hours of API work at 90 EUR plus a 300 EUR setup fee, 23% VAT, due in 14 days, and give me the PDF.';
const steps = (c?.steps?.length ? c.steps : [
  { tool: 'invoice_create', does: 'Creates INV-2026-0001 with two lines' },
  { tool: 'invoice_pdf', does: 'Renders the A4 PDF' },
]).slice(0, 2);

// Line items from the prompt. Math is computed here so the sheet and the case result can't drift apart.
const lines = [
  { d: 'API work', q: '12 h', u: 90, n: 12 },
  { d: 'Setup fee', q: '1', u: 300, n: 1 },
];
const fmt = (v: number) => v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const subtotal = lines.reduce((t, l) => t + l.u * l.n, 0);
const vat = Math.round(subtotal * 23) / 100;
const total = subtotal + vat;
if (c?.result && !c.result.includes(fmt(total))) console.warn(`[HeroDemo] invoice case total ${fmt(total)} not in case result`);
const issued = '30 Oct 2026';
const due = '13 Nov 2026';
---
<div class="desk" aria-label={`Example. You ask for an invoice in chat. The tools return INV-2026-0001 for Acme, total EUR ${fmt(total)}, later stamped paid.`} role="group">
  <!-- Chat: the real prompt and the real tool names, in order -->
  <div class="chat">
    <p class="chat-label"><span>{s?.name ?? 'Invoice'} server connected</span><span class="ex">Example</span></p>
    <div class="turn"><span class="who">You</span><p class="said">{prompt}</p></div>
    <div class="turn"><span class="who">Claude</span>
      <ol class="calls">
        {steps.map((st, i) => (
          <li style={`--d:${0.35 + i * 0.4}s`}><span class="tick" aria-hidden="true"></span><code>{st.tool}</code><span class="does">{st.does}</span></li>
        ))}
      </ol>
    </div>
    <div class="turn"><span class="who">You</span><p class="said">Acme paid today. Mark it paid.</p></div>
    <div class="turn"><span class="who">Claude</span>
      <ol class="calls">
        <li style="--d:1.45s"><span class="tick" aria-hidden="true"></span><code>invoice_mark_paid</code><span class="does">Status: paid</span></li>
      </ol>
    </div>
  </div>

  <!-- The document the tools produce -->
  <div class="doc-col">
  <div class="doc-wrap">
    <div class="carbon" aria-hidden="true"><span>Copy</span></div>
    <article class="doc">
      <header class="doc-head">
        <div>
          <p class="doc-type">Invoice</p>
          <p class="doc-no">INV-2026-0001</p>
        </div>
        <dl class="doc-meta">
          <dt>Bill to</dt><dd>Acme</dd>
          <dt>Issued</dt><dd>{issued}</dd>
          <dt>Due</dt><dd>{due}</dd>
          <dt>Status</dt><dd>PAID</dd>
        </dl>
      </header>
      <table class="doc-lines">
        <thead><tr><th scope="col">Item</th><th scope="col">Qty</th><th scope="col">Price</th><th scope="col">EUR</th></tr></thead>
        <tbody>
          {lines.map((l) => (<tr><td>{l.d}</td><td>{l.q}</td><td>{fmt(l.u)}</td><td>{fmt(l.u * l.n)}</td></tr>))}
        </tbody>
      </table>
      <div class="doc-bottom">
        <div class="stamp-pos"><Stamp state="PAID" sub="30 OCT 2026" size={74} rotate={-7} /></div>
        <dl class="doc-sum">
          <dt>Subtotal</dt><dd>{fmt(subtotal)}</dd>
          <dt>VAT 23%</dt><dd>{fmt(vat)}</dd>
          <dt class="tot">Total EUR</dt><dd class="tot">{fmt(total)}</dd>
        </dl>
      </div>
      <p class="doc-foot">Generated with mcp-invoice by theluckystrike</p>
    </article>
  </div>
    <p class="cap">Example. <code>invoice_pdf</code> writes an A4 PDF. After <code>invoice_mark_paid</code> its status line reads PAID. The stamp shows that state.</p>
  </div>
</div>

<style>
  .desk {
    position: relative; display: grid; gap: 1rem; align-items: start;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 900px) { .desk { grid-template-columns: minmax(0, 12.5rem) minmax(0, 1fr); gap: 1.25rem; } }

  /* Chat column: a narrow transcript, not a window chrome */
  .chat { display: grid; grid-template-columns: minmax(0, 1fr); gap: .45rem; font-size: .84rem; line-height: 1.45; position: relative; z-index: 2; }
  @media (min-width: 900px) { .chat { margin-top: 1.6rem; } }
  .chat-label { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .25rem .5rem; margin: 0; font-size: .72rem; color: var(--muted); font-weight: 560; }
  .ex { border: 1px solid var(--border-strong); border-radius: 2px; padding: 0 .45rem; font-size: .66rem; line-height: 1.45; }
  /* A typed memo: a rule on top, a mono margin label, no bubbles */
  .turn { display: grid; grid-template-columns: 3.6rem minmax(0, 1fr); gap: .15rem .5rem; padding-top: .45rem; border-top: 1px solid var(--border-strong); }
  @media (min-width: 900px) { .turn { grid-template-columns: minmax(0, 1fr); } }
  .who { font-family: var(--font-mono); font-size: .64rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding-top: .2rem; }
  .said { margin: 0; color: var(--text); }
  .calls { display: flex; flex-wrap: wrap; gap: .3rem .6rem; margin: 0; padding: .15rem 0 0; list-style: none; }
  @media (min-width: 900px) { .calls { flex-direction: column; } }
  .calls li { display: flex; align-items: center; gap: .4rem; min-width: 0; }
  .calls code { font-family: var(--font-mono); font-size: .74rem; color: var(--text); }
  .calls .does { display: none; color: var(--muted); font-size: .74rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (min-width: 900px) { .calls .does { display: inline; white-space: normal; flex-basis: 100%; padding-left: 1.3rem; margin-top: -.15rem; } .calls li { flex-wrap: wrap; } }
  .tick {
    flex: none; width: .9rem; height: .9rem; border-radius: 2px; background: var(--accent);
    -webkit-mask: none; position: relative;
  }
  .tick::after {
    content: ''; position: absolute; left: .29rem; top: .16rem; width: .25rem; height: .44rem;
    border: solid var(--accent-text); border-width: 0 2px 2px 0; transform: rotate(45deg);
  }

  /* Document: a sheet torn from a pad, with a carbon copy offset behind it */
  .doc-wrap { position: relative; padding: .5rem .25rem .75rem 0; filter: drop-shadow(0 14px 22px color-mix(in oklab, var(--text) 16%, transparent)) drop-shadow(0 1px 1px color-mix(in oklab, var(--text) 10%, transparent)); }
  .carbon {
    position: absolute; inset: 1.1rem -.35rem -.6rem 1.2rem; border-radius: 2px;
    background: var(--surface-2); border: 1px solid var(--border); transform: rotate(1.6deg);
  }
  .carbon span {
    position: absolute; right: .8rem; bottom: .5rem; font-size: .62rem; font-weight: 700; letter-spacing: .2em;
    text-transform: uppercase; color: var(--muted);
  }
  .doc {
    position: relative; padding: 1.1rem 1.1rem .9rem; border-radius: 2px;
    background: var(--paper, var(--surface-solid)); color: var(--text);
    border: 1px solid var(--border);
    font-size: .8rem; line-height: 1.4;
    /* Perforated top edge, cut with a mask: real holes, no color literal */
    -webkit-mask: radial-gradient(circle at 50% 0, transparent .22rem, #000 .24rem) top / .8rem .5rem repeat-x, linear-gradient(#000 0 0) 0 .5rem / 100% calc(100% - .5rem) no-repeat;
            mask: radial-gradient(circle at 50% 0, transparent .22rem, #000 .24rem) top / .8rem .5rem repeat-x, linear-gradient(#000 0 0) 0 .5rem / 100% calc(100% - .5rem) no-repeat;
    /* Ledger rules behind the lines */
    background-image: repeating-linear-gradient(180deg, transparent 0 1.55rem, var(--rule) 1.55rem calc(1.55rem + 1px));
  }
  @media (min-width: 640px) { .doc { padding: 1.5rem 1.6rem 1.1rem; font-size: .86rem; } }
  .doc-head { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .doc-type { margin: 0; font-weight: 750; font-size: 1.05rem; letter-spacing: 0; }
  @media (min-width: 640px) { .doc-type { font-size: 1.35rem; } }
  .doc-no { margin: .1rem 0 0; font-family: var(--font-mono); font-size: .76rem; color: var(--muted); }
  .doc-meta { display: grid; grid-template-columns: auto auto; gap: .05rem .7rem; margin: 0; font-size: .74rem; text-align: right; }
  .doc-meta dt { color: var(--muted); }
  .doc-meta dd { margin: 0; font-weight: 600; }
  .doc-lines { width: 100%; border-collapse: collapse; margin-top: .9rem; }
  .doc-lines th { font-size: .64rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; text-align: right; padding: .3rem 0; border-bottom: 1px solid var(--border-strong); }
  .doc-lines td { text-align: right; padding: .38rem 0; border-bottom: 1px solid var(--border); }
  .doc-lines th:first-child, .doc-lines td:first-child { text-align: left; }
  .doc-bottom { display: flex; justify-content: space-between; align-items: center; gap: .75rem; margin-top: .6rem; }
  .doc-sum { display: grid; grid-template-columns: 1fr auto; gap: .1rem 1rem; margin: 0; flex: 0 1 11.5rem; text-align: right; }
  @media (min-width: 640px) { .doc-sum { flex-basis: 14rem; } }
  .doc-sum dt { color: var(--muted); }
  .doc-sum dd { margin: 0; }
  .doc-sum .tot { font-weight: 750; font-size: 1rem; color: var(--text); border-top: 2px solid var(--text); padding-top: .25rem; margin-top: .2rem; }
  @media (min-width: 640px) { .doc-sum .tot { font-size: 1.15rem; } }
  .doc-foot { margin: .8rem 0 0; font-size: .66rem; color: var(--muted); font-family: var(--font-mono); }

  /* The stamp (d-identity Stamp.astro): sits over the line items, like a real PAID mark */
  .stamp-pos { flex: none; pointer-events: none; transform-origin: 50% 50%; padding-left: .25rem; }
  .stamp-pos :global(svg) { display: block; height: 4.1rem; width: auto; opacity: .92; }
  @media (min-width: 640px) { .stamp-pos { padding-left: .75rem; } .stamp-pos :global(svg) { height: 5.6rem; } }
  .cap { margin: 1.1rem 0 0; font-size: .74rem; color: var(--muted); line-height: 1.45; max-width: 36em; }
  .cap code { font-family: var(--font-mono); color: var(--text); }

  /* Motion. Rest state = final state. Plays once. */
  @media (prefers-reduced-motion: no-preference) {
    .calls li .tick { animation: d-tick .45s cubic-bezier(.3, 1.6, .5, 1) backwards; animation-delay: var(--d); }
    .calls li code { animation: d-ink .5s ease-out backwards; animation-delay: var(--d); }
    .doc { animation: d-feed .7s cubic-bezier(.2, .8, .2, 1) .55s backwards; }
    .stamp-pos { animation: d-stamp .42s cubic-bezier(.5, 0, .7, 1.4) 1.75s backwards; }
    .doc-wrap { animation: d-thud .25s ease-out 2.15s 1; }
  }
  @keyframes d-tick { from { transform: scale(.3); background: var(--border-strong); } }
  @keyframes d-ink { from { color: var(--muted); } }
  @keyframes d-feed { from { transform: translateY(14px); } }
  @keyframes d-stamp {
    0% { transform: rotate(5deg) scale(2.1); opacity: .3; }
    80% { transform: scale(.97); opacity: 1; }
    100% { transform: none; opacity: 1; }
  }
  @keyframes d-thud { 40% { transform: translateY(2px); } }
</style>
