---
// Server card. The top tab says what the server hands back (from pages/servers/_outputs.ts), so a buyer scans by output.
import type { Server } from '../data/servers';
import { getCategory } from '../data/categories';
import { outputType } from '../pages/servers/_outputs';
interface Props { server: Server }
const { server: s } = Astro.props;
const cat = getCategory(s.category);
const price = s.satellite ? 'Free calculator' : !s.paid ? 'Free' : s.bundleOnly ? 'In the bundle' : `Free tier, Pro $${s.priceUsd}`;
---
<a href={`/servers/${s.id}/`} class="sc cat group flex h-full flex-col" style={`--hue:${cat.hue}`}>
  <span class="sc-out">{outputType(s)}</span>
  <h3 class="mt-3 text-[1.18rem] font-semibold group-hover:text-accent">{s.name}</h3>
  <p class="muted mt-1.5 line-clamp-3 text-[.94rem] leading-relaxed">{s.tagline}</p>
  <p class="mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-4 text-[.78rem] font-medium text-faint">
    <span class="cat-text">{cat.short}</span><span>{price}</span>{s.hosted && <span>Hosted</span>}
  </p>
</a>
<style>
  .sc { padding: 1.1rem 0 1.2rem; border-top: 1px solid var(--border); }
  .sc:hover h3 { color: var(--accent); }
  .sc-out {
    align-self: flex-start; font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    padding: .15rem .45rem; border: 1px solid var(--border-strong); border-radius: .25rem; color: var(--text);
  }
</style>
