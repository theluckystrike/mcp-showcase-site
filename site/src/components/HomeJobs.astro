---
// Home "file index" (d-home): the six jobs buyers search for, ordered by keyword value (t-review2 defect 5, ANGLE.md).
// Each slip is a document: its file label, the real prompt from data/content, the tools in order and what comes back.
// Prompts and steps come from the content cases. The "file" and "out" strings restate numbers from the same case result.
import { getServer } from '../data/servers';

const JOBS = [
  { id: 'invoice', c: 0, path: '/use-cases/create-invoice-in-claude/', job: 'Create an invoice', file: 'INV-2026-0001.pdf', out: 'EUR 1,697.40', outSub: 'numbered A4 PDF, VAT 23%' },
  { id: 'quotes', c: 0, path: '/use-cases/send-a-quote-from-chat/', job: 'Send a quote', file: 'quote, Piekarnia Rogal', out: 'PLN 8,487.00', outSub: 'gross, valid 14 days' },
  { id: 'spreadsheet', c: 0, path: '/use-cases/edit-excel-files-in-claude/', job: 'Work in an Excel file', file: 'orders_q3.xlsx', out: '3,412 rows', outSub: 'summed into a 5-row table' },
  { id: 'pdf', c: 1, path: '/use-cases/merge-pdf-in-claude/', job: 'Merge PDFs', file: 'application-moore.pdf', out: '18 pages', outSub: '3 files joined in order' },
  { id: 'bank-statement', c: 0, path: '/use-cases/categorize-bank-statement/', job: 'Sort a bank CSV', file: 'mBank CSV, 3 months', out: '3 plans found', outSub: 'PLN 49, 89 and 120 a month' },
  { id: 'time-tracker', c: 1, path: '/use-cases/track-billable-time-in-claude/', job: 'Turn hours into an invoice', file: 'week, Northside Dental', out: 'GBP 660.00', outSub: '9.5 h at 60, 2 h at 45' },
];
const rows = JOBS.map((j) => {
  const s = getServer(j.id);
  const c = s?.cases[j.c];
  return c ? { ...j, name: s!.name, prompt: c.prompt, tools: c.steps.map((x) => x.tool) } : null;
}).filter((r) => r !== null);
---
<ol class="tray" aria-label="Jobs you can do in chat">
  {rows.map((r, i) => (
    <li class="slip" style={`--i:${i}`}>
      <a href={r.path} class="slip-link">
        <p class="tab"><span class="tab-no">{String(i + 1).padStart(2, '0')}</span><span class="tab-file">{r.file}</span></p>
        <div class="body">
          <h3 class="job">{r.job}</h3>
          <p class="prompt">&ldquo;{r.prompt}&rdquo;</p>
          <p class="tools">{r.tools.map((t, k) => (<>{k > 0 && <span class="arrow" aria-hidden="true"> then </span>}<code>{t}</code></>))}</p>
        </div>
        <p class="out"><span class="out-n">{r.out}</span><span class="out-sub">{r.outSub}</span><span class="out-go">{r.name} example <span aria-hidden="true">&rarr;</span></span></p>
      </a>
    </li>
  ))}
</ol>

<style>
  .tray { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 2px solid var(--text); }
  .slip { border-bottom: 1px solid var(--border-strong); }
  .slip-link {
    display: grid; gap: .5rem 1.5rem; padding: 1.1rem .25rem 1.2rem; color: inherit;
    grid-template-columns: 1fr; transition: background .15s ease;
  }
  @media (min-width: 900px) {
    .slip-link { grid-template-columns: 12.5rem minmax(0, 1fr) 13rem; align-items: start; padding: 1.4rem .75rem; }
  }
  .slip-link:hover { background: var(--surface-2); }
  .slip-link:hover .job { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .slip-link:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  .tab { margin: 0; display: flex; gap: .6rem; align-items: baseline; font-family: var(--font-mono); font-size: .76rem; color: var(--muted); min-width: 0; }
  @media (min-width: 900px) { .tab { flex-direction: column; gap: .35rem; padding-top: .3rem; } }
  .tab-no { color: var(--text); font-weight: 600; }
  .tab-file { overflow-wrap: anywhere; }

  .job { margin: 0; font-size: clamp(1.2rem, 2.2vw, 1.5rem); font-weight: 680; letter-spacing: -.02em; line-height: 1.15; }
  .prompt { margin: .45rem 0 0; color: var(--muted); font-size: .95rem; line-height: 1.5; max-width: 44em; }
  .tools { margin: .55rem 0 0; font-size: .74rem; color: var(--muted); }
  .tools code { font-family: var(--font-mono); color: var(--text); }

  .out { margin: 0; display: grid; gap: .1rem; font-variant-numeric: tabular-nums; }
  @media (min-width: 900px) { .out { text-align: right; padding-top: .1rem; } }
  .out-n { font-size: 1.45rem; font-weight: 720; letter-spacing: -.02em; line-height: 1.1; }
  .out-sub { font-size: .82rem; color: var(--muted); }
  .out-go { margin-top: .45rem; font-size: .84rem; font-weight: 600; color: var(--accent); }
</style>
