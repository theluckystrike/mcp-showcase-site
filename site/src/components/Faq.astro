---
interface Props { items: { q: string; a: string }[]; jsonLd?: boolean }
const { items } = Astro.props;
---
{items.length > 0 && (
  <div class="border-t border-line">
    {items.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <div>{f.a}</div>
      </details>
    ))}
  </div>
)}
