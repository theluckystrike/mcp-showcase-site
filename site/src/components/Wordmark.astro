---
// Logo = mark + wordmark. The name comes from brand.ts only. A name that starts with "mcp" (e.g. "McpLedger")
// renders the prefix quieter so the second word carries the brand; any other name renders as one word.
import { brand } from '../config/brand';
interface Props { size?: number }
const { size = 28 } = Astro.props;
const m = brand.name.match(/^(mcp)(.+)$/i);
---
<span class="inline-flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <rect width="32" height="32" rx="8" fill="var(--accent)" />
    <path d="M10 7.5h8.5l4.5 4.5v12.5a1 1 0 0 1-1 1H10a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1z" fill="#fffefb" />
    <path d="M18.5 7.5V12H23" fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-linejoin="round" opacity=".5" />
    <path d="M12 15.5h8M12 18.5h5.5" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" />
    <path d="M14.5 22.2l1.6 1.6 3.4-3.4" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="wordmark">{m ? <><span class="wm-pre">{m[1]}</span>{m[2]}</> : brand.name}</span>
</span>
