---
// Logo = mark + wordmark (d-identity, BRANDKIT.md). The mark is a rubber stamp over its red impression.
// Graphite parts use currentColor (works in dark mode); the impression uses --stamp.
// The name comes from brand.ts only. A name that starts with "mcp" renders the prefix quieter.
import { brand } from '../config/brand';
interface Props { size?: number }
const { size = 28 } = Astro.props;
const m = brand.name.match(/^(mcp)(.+)$/i);
---
<span class="inline-flex items-center gap-2">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="shrink-0 text-fg">
    <g fill="currentColor">
      <circle cx="16" cy="6.6" r="4.4" />
      <path d="M13.4 10.4h5.2l1.5 7.1h-8.2z" />
      <rect x="5.5" y="17.2" width="21" height="5.2" rx="1.1" />
      <rect x="7.2" y="22.4" width="17.6" height="2.2" />
    </g>
    <rect x="3.5" y="26.9" width="25" height="2.9" rx=".5" transform="rotate(-3 16 28.3)" fill="var(--stamp)" />
  </svg>
  <span class="wordmark">{m ? <><span class="wm-pre">{m[1]}</span>{m[2]}</> : brand.name}</span>
</span>
