---
// What the user gets: the invoice from the first Invoice example case, drawn in HTML/CSS (no image).
// Numbers come from data/content case "Bill a client in one message" (12 h x EUR 90 + EUR 300 setup, 23% VAT, due in 14 days):
// 1,080.00 + 300.00 = 1,380.00; VAT 23% = 317.40; total 1,697.40. Checked by t-review (REVIEW.md insight 2).
// Names are invented. It is an Example, labeled as one.
interface Props { compact?: boolean; caption?: boolean }
const { compact = false, caption = true } = Astro.props;
const lines = [
  { d: 'API work', q: '12 h', u: '90.00', t: '1,080.00' },
  { d: 'Setup fee', q: '1', u: '300.00', t: '300.00' },
];
---
<figure class="m-0">
  <div class:list={['sheet sheet-fold overflow-hidden', compact ? 'p-4 text-[.72rem]' : 'p-5 text-[.8rem] sm:p-6']} aria-label="Example invoice INV-2026-0001 for Acme, total EUR 1,697.40">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class:list={['font-bold', compact ? 'text-[.95rem]' : 'text-[1.1rem]']}>Invoice</p>
        <p class="sheet-muted font-mono">INV-2026-0001</p>
      </div>
      <div class="pr-5 text-right">
        <p class="font-semibold">Your business</p>
        <p class="sheet-muted">Lisbon, PT</p>
      </div>
    </div>
    <div class:list={['sheet-rule grid grid-cols-2 gap-3 border-y', compact ? 'mt-3 py-2' : 'mt-4 py-3']}>
      <div><p class="sheet-muted text-[.68rem] font-semibold uppercase tracking-[.08em]">Bill to</p><p class="font-semibold">Acme</p></div>
      <div class="text-right"><p class="sheet-muted text-[.68rem] font-semibold uppercase tracking-[.08em]">Due</p><p class="font-semibold">in 14 days</p></div>
    </div>
    <table class="mt-2 w-full border-collapse">
      <thead>
        <tr class="sheet-muted text-[.66rem] uppercase tracking-[.06em]">
          <th scope="col" class="py-1.5 text-left font-semibold">Item</th>
          <th scope="col" class="py-1.5 text-right font-semibold">Qty</th>
          <th scope="col" class="py-1.5 text-right font-semibold">Price</th>
          <th scope="col" class="py-1.5 text-right font-semibold">EUR</th>
        </tr>
      </thead>
      <tbody>
        {lines.map((l) => (
          <tr class="sheet-rule border-t">
            <td class="py-1.5">{l.d}</td><td class="py-1.5 text-right">{l.q}</td><td class="py-1.5 text-right">{l.u}</td><td class="py-1.5 text-right">{l.t}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="relative mt-2 flex items-end justify-between gap-4">
      <span class="stamp mb-1 ml-1" aria-hidden="true">Ready</span>
      <dl class="grid min-w-[11rem] grid-cols-[1fr_auto] gap-x-4 gap-y-0.5 text-right">
        <dt class="sheet-muted">Subtotal</dt><dd>1,380.00</dd>
        <dt class="sheet-muted">VAT 23%</dt><dd>317.40</dd>
        <dt class="sheet-rule mt-1 border-t pt-1 font-bold">Total</dt><dd class="sheet-rule mt-1 border-t pt-1 font-bold" style="color: var(--accent)">EUR 1,697.40</dd>
      </dl>
    </div>
  </div>
  {caption && <figcaption class="mt-2.5 text-[.8rem] text-faint">Example output of <code class="font-mono">invoice_pdf</code>, an A4 PDF. Names are invented, the math is real.</figcaption>}
</figure>
