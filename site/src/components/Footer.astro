---
import { brand } from '../config/brand';
import Wordmark from './Wordmark.astro';
import { CATEGORIES } from '../data/categories';
import { pagesOfType } from '../data/pages';
import { upsell } from '../data/content';
import { bundleUrl, buyUrl } from '../data/servers';
const audiences = pagesOfType('audience');
const foot = upsell('all', 'footer', { copy: `All paid servers, one key, $${brand.pricing.bundleUsd} once.`, cta_url: buyUrl(bundleUrl(), 'footer', 'bundle') });
const year = new Date().getFullYear();
---
<footer class="relative mt-24 border-t border-line" style="background: var(--bg-2)">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex" aria-label={`${brand.name} home`}><Wordmark size={26} /></a>
      <p class="muted mt-4 max-w-xs text-[.95rem]">{brand.tagline} Open-source MCP servers for Claude, Cursor and any MCP client.</p>
      <p class="mt-5 text-[.93rem]"><a href="/pricing/" class="link">{foot.copy}</a></p>
    </div>
    <div>
      <h2 class="mb-3 text-sm font-semibold">For you</h2>
      <ul class="grid gap-2 text-[.93rem]">
        {audiences.map((a) => <li><a class="muted hover:text-fg" href={a.path}>{a.h1}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="mb-3 text-sm font-semibold">Product</h2>
      <ul class="grid gap-2 text-[.93rem]">
        <li><a class="muted hover:text-fg" href="/servers/">All servers</a></li>
        <li><a class="muted hover:text-fg" href="/use-cases/">Use cases</a></li>
        <li><a class="muted hover:text-fg" href="/connect/">Connect</a></li>
        <li><a class="muted hover:text-fg" href="/categories/invoicing/">Categories</a></li>
        <li><a class="muted hover:text-fg" href="/compare/">Compare</a></li>
        <li><a class="muted hover:text-fg" href="/pricing/">Pricing</a></li>
      </ul>
    </div>
    <div>
      <h2 class="mb-3 text-sm font-semibold">Build</h2>
      <ul class="grid gap-2 text-[.93rem]">
        <li><a class="muted hover:text-fg" href="/developers/">Developers</a></li>
        <li><a class="muted hover:text-fg" href={brand.links.github} rel="noopener">GitHub</a></li>
        <li><a class="muted hover:text-fg" href={brand.links.registry} rel="noopener">MCP Registry</a></li>
        <li><a class="muted hover:text-fg" href="/llms.txt">llms.txt</a></li>
        <li><a class="muted hover:text-fg" href="/about/">About</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap justify-between gap-3 border-t border-line py-6 text-sm text-faint">
    <span>&copy; {year} {brand.name}</span>
    <span>Case examples are scenarios, labeled "Example".</span>
  </div>
</footer>
