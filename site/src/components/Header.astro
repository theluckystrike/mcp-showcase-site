---
// Header (d-identity, BRANDKIT.md). Solid ledger paper, a double rule underneath like the head of a printed form.
// Active link = a red pen underline. One primary action.
import { brand } from '../config/brand';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/servers/', label: 'Servers' },
  { href: '/use-cases/', label: 'Use cases' },
  { href: '/connect/', label: 'Connect' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/services/', label: 'Services' },
  { href: '/developers/', label: 'Developers' },
];
---
<script is:inline>
  // Light is the default. Dark only when the visitor picked it. Runs before the page paints below the header.
  try { if (localStorage.getItem('mode') === 'dark' || /[?&]mode=dark\b/.test(location.search)) document.documentElement.dataset.mode = 'dark'; } catch (e) {}
  (function () { var h = document.documentElement; h.classList.add('js');
    var f = function () { h.classList.toggle('scrolled', window.scrollY > window.innerHeight * 0.5); };
    f(); window.addEventListener('scroll', f, { passive: true }); })();
  (function () { var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', document.documentElement.dataset.mode === 'dark' ? '#10141f' : '#eef0ea'); })();
</script>
<header class="site-head sticky top-0 z-40">
  <div class="wrap flex h-16 items-center gap-4">
    <a href="/" class="flex items-center" aria-label={`${brand.name} home`}>
      <Wordmark />
    </a>
    <nav class="ml-6 hidden items-center lg:flex" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} class:list={['nav-link', path.startsWith(n.href) && 'is-active']} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <button id="theme-toggle" type="button" class="btn btn-sm !px-2.5" aria-label="Switch between light and dark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z"/></svg>
      </button>
      <a href="/connect/" class="btn btn-primary btn-sm hidden sm:inline-flex">Connect free</a>
      <details class="relative lg:hidden">
        <summary class="btn btn-sm !px-2.5 list-none [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav class="menu-sheet absolute right-0 top-12 grid w-60 p-2" aria-label="Mobile">
          {nav.map((n, i) => <a href={n.href} class="menu-link"><span class="serial">{String(i + 1).padStart(2, '0')}</span>{n.label}</a>)}
          <a href="/about/" class="menu-link"><span class="serial">{String(nav.length + 1).padStart(2, '0')}</span>About</a>
          <a href="/connect/" class="btn btn-primary btn-sm mt-2">Connect free</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .site-head { background: var(--bg); border-bottom: 2px solid var(--text); box-shadow: 0 2px 0 0 var(--bg), 0 3px 0 0 var(--text); }
  .nav-link { position: relative; padding: .45rem .7rem; font-size: .93rem; font-weight: 520; color: var(--muted); transition: color .15s; }
  .nav-link:hover { color: var(--text); }
  .nav-link.is-active { color: var(--text); font-weight: 640; }
  .nav-link.is-active::after { content: ''; position: absolute; left: .55rem; right: .55rem; bottom: .05rem; height: 2px; background: var(--stamp); transform: rotate(-1.2deg); border-radius: 2px; }
  .menu-sheet { background: var(--surface-solid); border: 1px solid var(--border-strong); border-radius: 3px; box-shadow: var(--shadow-lift); }
  .menu-link { display: flex; align-items: baseline; gap: .7rem; padding: .7rem .75rem; border-bottom: 1px solid var(--border); font-weight: 540; }
  .menu-link:hover { background: var(--surface-2); }
  .menu-link .serial { color: var(--stamp); }
</style>
<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', function () {
    var h = document.documentElement; var dark = h.dataset.mode !== 'dark';
    if (dark) h.dataset.mode = 'dark'; else delete h.dataset.mode;
    try { localStorage.setItem('mode', dark ? 'dark' : 'light'); } catch (e) {}
    var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', dark ? '#10141f' : '#eef0ea');
  });
</script>
