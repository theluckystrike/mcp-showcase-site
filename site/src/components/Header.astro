---
import { brand } from '../config/brand';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/servers/', label: 'Servers' },
  { href: '/use-cases/', label: 'Use cases' },
  { href: '/connect/', label: 'Connect' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/developers/', label: 'Developers' },
];
---
<script is:inline>
  // Light is the default. Dark only when the visitor picked it (t-design). Runs before the page paints below the header.
  try { if (localStorage.getItem('mode') === 'dark') document.documentElement.dataset.mode = 'dark'; } catch (e) {}
  (function () { var h = document.documentElement; h.classList.add('js');
    var f = function () { h.classList.toggle('scrolled', window.scrollY > window.innerHeight * 0.5); };
    f(); window.addEventListener('scroll', f, { passive: true }); })();
  (function () { var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', document.documentElement.dataset.mode === 'dark' ? '#151412' : '#f7f4ee'); })();
</script>
<header class="sticky top-0 z-40 border-b border-line backdrop-blur-xl" style="background: color-mix(in oklab, var(--bg) 86%, transparent)">
  <div class="wrap flex h-16 items-center gap-4">
    <a href="/" class="flex items-center" aria-label={`${brand.name} home`}>
      <Wordmark />
    </a>
    <nav class="ml-6 hidden items-center gap-1 md:flex" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} class:list={['rounded-lg px-3 py-1.5 text-[.93rem] transition-colors hover:text-fg', path.startsWith(n.href) ? 'text-fg font-semibold bg-surface-2' : 'text-muted']} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <button id="theme-toggle" type="button" class="btn btn-sm !px-2.5" aria-label="Switch between light and dark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z"/></svg>
      </button>
      <a href="/connect/" class="btn btn-primary btn-sm hidden sm:inline-flex">Connect free</a>
      <details class="relative md:hidden">
        <summary class="btn btn-sm !px-2.5 list-none [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav class="card absolute right-0 top-12 grid w-56 gap-1 p-2" style="background: var(--surface-solid)" aria-label="Mobile">
          {nav.map((n) => <a href={n.href} class="rounded-lg px-3 py-2.5 hover:bg-surface-2">{n.label}</a>)}
          <a href="/about/" class="rounded-lg px-3 py-2.5 hover:bg-surface-2">About</a>
          <a href="/connect/" class="btn btn-primary btn-sm mt-1">Connect free</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', function () {
    var h = document.documentElement; var dark = h.dataset.mode !== 'dark';
    if (dark) h.dataset.mode = 'dark'; else delete h.dataset.mode;
    try { localStorage.setItem('mode', dark ? 'dark' : 'light'); } catch (e) {}
    var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', dark ? '#151412' : '#f7f4ee');
  });
</script>
