---
// d-servers: "What you get" on a server page. A document sheet or a report table with the real numbers of one example case
// (data in pages/servers/_outputs.ts). Servers without a hand preview get a result slip from their first case:
// the tool calls as ledger lines and the case result as the closing line. A stamp appears only for a document state.
import type { Server } from '../data/servers';
import { PREVIEWS, outputType } from '../pages/servers/_outputs';
interface Props { server: Server }
const { server: s } = Astro.props;
const p = PREVIEWS[s.id];
const c = p ? s.cases[p.case] : s.cases[0];
const label = outputType(s);
const numeric = (v: string) => /^-?[\d.,]+$|^about [\d,]+$/.test(v);
---
{(p || c) && (
<figure class="out m-0">
  <div class="sheet out-sheet" aria-label={`Example output: ${label}`}>
    <div class="out-perf" aria-hidden="true"></div>
    {p?.kind === 'doc' ? (
      <div class="out-body">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="out-doc">{p.doc}</p>
            {p.number && <p class="sheet-muted font-mono text-[.78rem]">{p.number}</p>}
          </div>
          <span class="out-file">{p.file}</span>
        </div>
        {(p.to || p.meta) && (
          <div class="sheet-rule out-meta">
            {p.to && <div><p class="out-lbl">{p.to[0]}</p><p class="font-semibold">{p.to[1]}</p></div>}
            {p.meta?.map(([k, v]) => <div><p class="out-lbl">{k}</p><p class="font-semibold">{v}</p></div>)}
          </div>
        )}
        <table class="out-table">
          <thead><tr>{p.cols.map((h, i) => <th scope="col" class={i ? 'r' : ''}>{h}</th>)}</tr></thead>
          <tbody>{p.rows.map((r) => <tr>{r.map((v, i) => <td class:list={[i && 'r', i && numeric(v) && 'tnum', p.cols[i] === 'Tool' && 'font-mono text-[.76rem]']}>{v}</td>)}</tr>)}</tbody>
        </table>
        <div class="out-foot">
          {p.stamp ? <span class:list={['stamp', `stamp-${p.stamp.tone}`]}>{p.stamp.text}</span> : <span></span>}
          <dl class="out-totals">
            {p.totals.map(([k, v], i) => (
              <>
                <dt class:list={[i === p.totals.length - 1 && 'out-grand']}>{k}</dt>
                <dd class:list={['tnum', i === p.totals.length - 1 && 'out-grand']}>{v}</dd>
              </>
            ))}
          </dl>
        </div>
      </div>
    ) : p?.kind === 'table' ? (
      <div class="out-body">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="out-doc">{p.title}</p>
            {p.sub && <p class="sheet-muted text-[.8rem]">{p.sub}</p>}
          </div>
          <span class="out-file">{p.file}</span>
        </div>
        <table class="out-table mt-4">
          <thead><tr>{p.cols.map((h, i) => <th scope="col" class={i ? 'r' : ''}>{h}</th>)}</tr></thead>
          <tbody>{p.rows.map((r) => <tr>{r.map((v, i) => <td class:list={[i && 'r tnum']}>{v}</td>)}</tr>)}</tbody>
          {p.foot && <tfoot><tr><th scope="row" colspan={p.cols.length - 1}>{p.foot[0]}</th><td class="r tnum">{p.foot[1]}</td></tr></tfoot>}
        </table>
        {p.stamp && <div class="mt-3 flex justify-end"><span class:list={['stamp', `stamp-${p.stamp.tone}`]}>{p.stamp.text}</span></div>}
      </div>
    ) : c ? (
      <div class="out-body">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="out-doc">{c.title}</p>
            {c.persona && <p class="sheet-muted text-[.8rem]">{c.persona}</p>}
          </div>
          <span class="out-file">{label}</span>
        </div>
        <table class="out-table mt-4">
          <thead><tr><th scope="col">Tool call</th><th scope="col">What it did</th></tr></thead>
          <tbody>{c.steps.map((st) => <tr><td class="whitespace-nowrap font-mono text-[.76rem]">{st.tool}</td><td>{st.does}</td></tr>)}</tbody>
        </table>
        {c.result && <p class="out-result">{c.result}</p>}
      </div>
    ) : null}
  </div>
  <figcaption class="mt-3 text-[.8rem] text-faint">
    Example{c ? <> from "{c.title}"</> : ''}. Invented names, real math from the tools.{p?.note && ` ${p.note}`}
  </figcaption>
</figure>
)}

<style>
  .out-sheet { position: relative; padding: 0; overflow: hidden; }
  .out-perf {
    height: 10px;
    background: radial-gradient(circle at 6px -1px, var(--bg) 3.2px, transparent 3.6px) 0 0 / 12px 10px repeat-x;
    border-bottom: 1px dashed var(--border);
  }
  .out-body { padding: 1.25rem 1.3rem 1.3rem; font-size: .84rem; }
  @media (min-width: 640px) { .out-body { padding: 1.6rem 1.8rem 1.7rem; } }
  .out-doc { font-weight: 720; font-size: 1.12rem; letter-spacing: -0.02em; line-height: 1.2; }
  .out-file {
    flex: none; font-family: var(--font-mono); font-size: .66rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    padding: .2rem .45rem; border: 1px solid currentColor; border-radius: .25rem; color: var(--muted);
  }
  .out-lbl { font-size: .66rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
  .out-meta { display: flex; flex-wrap: wrap; gap: .6rem 2rem; margin-top: 1rem; padding: .7rem 0; border-top: 1px solid; border-bottom: 1px solid; }
  .out-table { width: 100%; border-collapse: collapse; margin-top: .6rem; }
  .out-table th { font-size: .66rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; text-align: left; padding: .45rem 0; opacity: .7; }
  .out-table td { padding: .5rem 0; border-top: 1px solid var(--rule, var(--border)); vertical-align: top; }
  .out-table td + td, .out-table th + th { padding-left: .9rem; }
  .out-table .r { text-align: right; }
  .out-table tfoot th, .out-table tfoot td {
    font-size: .92rem; font-weight: 720; text-transform: none; letter-spacing: 0; opacity: 1;
    border-top: 2px solid currentColor; padding-top: .6rem; color: var(--accent);
  }
  .out-table tfoot th { color: inherit; }
  .out-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-top: .6rem; }
  .out-totals { display: grid; grid-template-columns: 1fr auto; gap: .15rem 1.2rem; text-align: right; min-width: 11rem; }
  .out-totals dt { opacity: .75; }
  .out-totals .out-grand { opacity: 1; font-weight: 720; font-size: .98rem; border-top: 2px solid currentColor; padding-top: .35rem; margin-top: .25rem; }
  .out-totals dd.out-grand { color: var(--accent); }
  .out-result { margin-top: 1rem; padding-top: .8rem; border-top: 2px solid currentColor; font-weight: 560; line-height: 1.45; }
  .out .stamp { font-size: .78rem; margin: 0 0 .3rem .2rem; }
  .out .stamp-ok { --stamp: var(--accent); }
</style>
